diff --git a/drivers/media/platform/apple/isp-t7000/isp.h b/drivers/media/platform/apple/isp-t7000/isp.h
index b786df251..ab9249ee0 100644
--- a/drivers/media/platform/apple/isp-t7000/isp.h
+++ b/drivers/media/platform/apple/isp-t7000/isp.h
@@ -182,6 +182,13 @@ struct isp_stream {
 	struct isp_surf *lists;		/* ISP_BUFLIST_SLOT per BUF_H2T slot */
 	struct isp_surf *setf;		/* setfile copy for CH_SET_FILE_LOAD */
 	u32 seq;
