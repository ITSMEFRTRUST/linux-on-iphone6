@@ -404,6 +411,8 @@ void isp_stream_kick(struct t7000_isp *isp);
 /* isp-af.c */
 void isp_af_power(struct t7000_isp *isp, bool on);
 void isp_af_prestart(struct t7000_isp *isp);
+void isp_af_prestop(struct t7000_isp *isp);
