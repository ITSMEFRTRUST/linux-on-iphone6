From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:26:24 +0000
Subject: [PATCH 044/138] arm64: dts: apple: t7000: Add the PCIe controller and
 the port 1 DART

Describe the A8 PCIe controller from the iOS device tree: ECAM, common
block, two port blocks and the shared PHY 0. IRQs are 212 and 215, and
32 MSIs land on AIC 224. Port 1 is the only port with a DART.

iOS gates PCIE, PCIE_AUX and PCIE_REF in that order: chain the three
power domains so the controller only needs the last one.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000-pmgr.dtsi |  3 ++
 arch/arm64/boot/dts/apple/t7000.dtsi      | 64 +++++++++++++++++++++++
 2 files changed, 67 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-pmgr.dtsi b/arch/arm64/boot/dts/apple/t7000-pmgr.dtsi
index 5948fa7af..28dbc2871 100644
--- a/arch/arm64/boot/dts/apple/t7000-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000-pmgr.dtsi
@@ -427,6 +427,8 @@ ps_pcie_ref: power-controller@20220 {
 		#power-domain-cells = <0>;
 		#reset-cells = <0>;
 		label = "pcie_ref";
+		/* iOS order: PCIE, then PCIE_AUX, then PCIE_REF */
+		power-domains = <&ps_pcie_aux>;
 	};
 
 	ps_hsic0_phy: power-controller@20200 {
@@ -593,6 +595,7 @@ ps_pcie_aux: power-controller@20310 {
 		#power-domain-cells = <0>;
 		#reset-cells = <0>;
 		label = "pcie_aux";
+		power-domains = <&ps_pcie>;
 	};
 
 	ps_gfx: power-controller@20320 {
diff --git a/arch/arm64/boot/dts/apple/t7000.dtsi b/arch/arm64/boot/dts/apple/t7000.dtsi
index 795789de0..7258425eb 100644
--- a/arch/arm64/boot/dts/apple/t7000.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000.dtsi
@@ -466,6 +466,70 @@ i2c3_pins: i2c3-pins {
 					 <APPLE_PINMUX(86, 1)>;
 			};
 		};
+
+		pcie: pcie@610000000 {
+			compatible = "apple,t7000-pcie";
+			device_type = "pci";
+
+			reg = <0x6 0x10000000 0x0 0x1000000>,
+			      <0x6 0x00000000 0x0 0x2000>,
+			      <0x6 0x01004000 0x0 0x1000>,
+			      <0x6 0x02004000 0x0 0x1000>,
+			      <0x6 0x01005000 0x0 0x1000>;
+			reg-names = "config", "rc", "port0", "port1", "phy0";
+
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 212 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 215 IRQ_TYPE_LEVEL_HIGH>;
+
+			msi-controller;
+			msi-parent = <&pcie>;
+			/* The doorbell is hardwired at 0xbffff000 */
+			msi-ranges = <&aic AIC_IRQ 224 IRQ_TYPE_EDGE_RISING 32>;
+
+			/* Only port 1 has a DART; port 0 is the unused NVMe port */
+			iommu-map = <0x100 &dart_apcie1 0 1>;
+			iommu-map-mask = <0xff00>;
+
+			bus-range = <0 8>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x43000000 0x6 0x20000000 0x6 0x20000000 0x1 0xa0000000>,
+				 <0x02000000 0x0 0xc0000000 0x7 0xc0000000 0x0 0x40000000>;
+
+			/* Chained to PCIE_AUX and PCIE in t7000-pmgr.dtsi */
+			power-domains = <&ps_pcie_ref>;
+			status = "disabled";
+
+			port01: pci@1,0 {
+				device_type = "pci";
+				reg = <0x800 0x0 0x0 0x0 0x0>;
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				interrupt-controller;
+				#interrupt-cells = <1>;
+
+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &port01 0 0 0 0>,
+						<0 0 0 2 &port01 0 0 0 1>,
+						<0 0 0 3 &port01 0 0 0 2>,
+						<0 0 0 4 &port01 0 0 0 3>;
+				status = "disabled";
+			};
+		};
+
+		dart_apcie1: iommu@602002000 {
+			compatible = "apple,t7000-dart", "apple,s5l8960x-dart";
+			reg = <0x6 0x02002000 0x0 0x2000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 216 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pcie_ref>;
+			status = "disabled";
+		};
 	};
 
 	timer {
