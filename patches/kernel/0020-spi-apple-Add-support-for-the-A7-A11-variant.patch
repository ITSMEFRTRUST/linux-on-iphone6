From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sat, 17 Oct 2026 23:58:22 +0000
Subject: [PATCH 020/138] spi: apple: Add support for the A7-A11 variant

The A7-A11 SPI block keeps the FIFO levels and the interrupt flags in
STATUS (write-1-to-clear), has its interrupt enables in CFG and lacks
the SHIFTCFG/PINCFG/delay registers. Its FIFO only accepts data while
RUN is set and the transfer starts as soon as data is queued. Like iOS,
run every transfer full duplex, 8 bits per word, and re-program CFG per
message since the block loses its state when its power domain is off.

Tested on the iPhone 6 (T7000) spi2 at 1-20 MHz, 4000-byte transfers,
both the polled and the interrupt path.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/spi/spi-apple.c | 161 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 154 insertions(+), 7 deletions(-)

diff --git a/drivers/spi/spi-apple.c b/drivers/spi/spi-apple.c
index 61eefb08d..825ec482e 100644
--- a/drivers/spi/spi-apple.c
+++ b/drivers/spi/spi-apple.c
@@ -46,6 +46,10 @@
 #define APPLE_SPI_STATUS_RXCOMPLETE	BIT(0)
 #define APPLE_SPI_STATUS_TXRXTHRESH	BIT(1)
 #define APPLE_SPI_STATUS_TXCOMPLETE	BIT(2)
+/* S5L (A7-A11) variant: FIFO levels live in STATUS, no FIFOSTAT/IE/IF regs */
+#define APPLE_SPI_STATUS_LEVEL_TX	GENMASK(10, 6)
+#define APPLE_SPI_STATUS_LEVEL_RX	GENMASK(15, 11)
+#define APPLE_SPI_STATUS_S5L_CLEAR	0x40000f
 
 #define APPLE_SPI_PIN			0x00c
 #define APPLE_SPI_PIN_KEEP_MOSI		BIT(0)
@@ -108,6 +112,12 @@
 
 #define APPLE_SPI_FIFO_DEPTH		16
 
+/*
+ * iOS always sets these CFG bits on the S5L variant; bit 3 is also set at
+ * reset. Their function is unknown.
+ */
+#define APPLE_SPI_CFG_S5L_BASE		(BIT(3) | BIT(4) | BIT(14))
+
 /*
  * The slowest refclock available is 24MHz, the highest divider is 0x7ff,
  * the largest word size is 32 bits, the FIFO depth is 16, the maximum
@@ -124,6 +134,7 @@ struct apple_spi {
 	void __iomem      *regs;        /* MMIO register address */
 	struct clk        *clk;         /* bus clock */
 	struct completion done;         /* wake-up from interrupt */
+	bool              s5l;          /* older (A7-A11) register layout */
 };
 
 static inline void reg_write(struct apple_spi *spi, int offset, u32 value)
@@ -170,6 +181,8 @@ static void apple_spi_init(struct apple_spi *spi)
 	reg_write(spi, APPLE_SPI_DELAY_POST, 0);
 }
 
+static void apple_spi_s5l_init(struct apple_spi *spi);
+
 static int apple_spi_prepare_message(struct spi_controller *ctlr, struct spi_message *msg)
 {
 	struct apple_spi *spi = spi_controller_get_devdata(ctlr);
@@ -179,6 +192,10 @@ static int apple_spi_prepare_message(struct spi_controller *ctlr, struct spi_mes
 		   (device->mode & SPI_CPOL ? APPLE_SPI_CFG_CPOL : 0) |
 		   (device->mode & SPI_LSB_FIRST ? APPLE_SPI_CFG_LSB_FIRST : 0));
 
+	/* The S5L variant loses its configuration when its power domain goes off */
+	if (spi->s5l)
+		apple_spi_s5l_init(spi);
+
 	/* Update core config */
 	reg_mask(spi, APPLE_SPI_CFG,
 		 APPLE_SPI_CFG_CPHA | APPLE_SPI_CFG_CPOL | APPLE_SPI_CFG_LSB_FIRST, cfg);
@@ -201,9 +218,10 @@ static bool apple_spi_prep_transfer(struct apple_spi *spi, struct spi_transfer *
 	cr = DIV_ROUND_UP(clk_get_rate(spi->clk), t->speed_hz);
 	reg_write(spi, APPLE_SPI_CLKDIV, min_t(u32, cr, APPLE_SPI_CLKDIV_MAX));
 
-	/* Update bits per word */
-	reg_mask(spi, APPLE_SPI_SHIFTCFG, APPLE_SPI_SHIFTCFG_BITS,
-		 FIELD_PREP(APPLE_SPI_SHIFTCFG_BITS, t->bits_per_word));
+	/* Update bits per word (the S5L variant only does 8, set at init) */
+	if (!spi->s5l)
+		reg_mask(spi, APPLE_SPI_SHIFTCFG, APPLE_SPI_SHIFTCFG_BITS,
+			 FIELD_PREP(APPLE_SPI_SHIFTCFG_BITS, t->bits_per_word));
 
 	/* We will want to poll if the time we need to wait is
 	 * less than the context switching time.
@@ -454,6 +472,129 @@ static int apple_spi_transfer_one(struct spi_controller *ctlr, struct spi_device
 	return ret;
 }
 
+/*
+ * S5L variant (A7-A11, ADT "spi-1,samsung"): an older version of the block.
+ * The registers up to TXCNT match, but the FIFO levels and the interrupt
+ * flags are in STATUS (flags are write-1-to-clear), the interrupt enables
+ * are in CFG, and the FIFO only accepts data while RUN is set. Like iOS,
+ * always run full duplex: pad TX with 0xff and drop unwanted RX bytes.
+ */
+static void apple_spi_s5l_init(struct apple_spi *spi)
+{
+	reg_write(spi, APPLE_SPI_PIN, APPLE_SPI_PIN_CS);
+	reg_write(spi, APPLE_SPI_CTRL, APPLE_SPI_CTRL_RX_RESET | APPLE_SPI_CTRL_TX_RESET);
+	reg_write(spi, APPLE_SPI_CFG, APPLE_SPI_CFG_S5L_BASE |
+		  FIELD_PREP(APPLE_SPI_CFG_MODE, APPLE_SPI_CFG_MODE_IRQ) |
+		  FIELD_PREP(APPLE_SPI_CFG_WORD_SIZE, APPLE_SPI_CFG_WORD_SIZE_8B));
+	reg_write(spi, APPLE_SPI_WORD_DELAY, 0);
+	reg_write(spi, APPLE_SPI_STATUS, APPLE_SPI_STATUS_S5L_CLEAR);
+}
+
+static irqreturn_t apple_spi_s5l_irq(int irq, void *dev_id)
+{
+	struct apple_spi *spi = dev_id;
+	u32 cfg = reg_read(spi, APPLE_SPI_CFG);
+	u32 status = reg_read(spi, APPLE_SPI_STATUS);
+	u32 pending = 0;
+
+	if (cfg & APPLE_SPI_CFG_IE_RXCOMPLETE)
+		pending |= status & APPLE_SPI_STATUS_RXCOMPLETE;
+	if (cfg & APPLE_SPI_CFG_IE_TXRXTHRESH)
+		pending |= status & APPLE_SPI_STATUS_TXRXTHRESH;
+
+	if (!pending)
+		return IRQ_NONE;
+
+	/* Disable interrupts until the next wait */
+	reg_write(spi, APPLE_SPI_CFG,
+		  cfg & ~(APPLE_SPI_CFG_IE_RXCOMPLETE | APPLE_SPI_CFG_IE_TXRXTHRESH));
+	complete(&spi->done);
+	return IRQ_HANDLED;
+}
+
+static int apple_spi_s5l_wait(struct apple_spi *spi, bool poll)
+{
+	const u32 flags = APPLE_SPI_STATUS_RXCOMPLETE | APPLE_SPI_STATUS_TXRXTHRESH;
+	const u32 ie = APPLE_SPI_CFG_IE_RXCOMPLETE | APPLE_SPI_CFG_IE_TXRXTHRESH;
+	unsigned long timeout;
+	u32 status;
+
+	if (poll) {
+		timeout = jiffies + msecs_to_jiffies(APPLE_SPI_TIMEOUT_MS);
+		do {
+			status = reg_read(spi, APPLE_SPI_STATUS);
+			if ((status & flags) || FIELD_GET(APPLE_SPI_STATUS_LEVEL_RX, status))
+				return 0;
+		} while (!time_after(jiffies, timeout));
+
+		return -ETIMEDOUT;
+	}
+
+	reinit_completion(&spi->done);
+	reg_mask(spi, APPLE_SPI_CFG, 0, ie);
+
+	if (!wait_for_completion_timeout(&spi->done, msecs_to_jiffies(APPLE_SPI_TIMEOUT_MS))) {
+		reg_mask(spi, APPLE_SPI_CFG, ie, 0);
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static int apple_spi_s5l_transfer_one(struct spi_controller *ctlr, struct spi_device *device,
+				      struct spi_transfer *t)
+{
+	struct apple_spi *spi = spi_controller_get_devdata(ctlr);
+	bool poll = apple_spi_prep_transfer(spi, t);
+	const u8 *tx = t->tx_buf;
+	u8 *rx = t->rx_buf;
+	u32 sent = 0, received = 0;
+	u32 status, level;
+	int ret = 0;
+
+	reg_write(spi, APPLE_SPI_STATUS, APPLE_SPI_STATUS_S5L_CLEAR);
+	reg_write(spi, APPLE_SPI_TXCNT, t->len);
+	reg_write(spi, APPLE_SPI_RXCNT, t->len);
+
+	/* Reset the FIFOs and start; data goes out as soon as it is queued */
+	reg_write(spi, APPLE_SPI_CTRL, APPLE_SPI_CTRL_RUN |
+		  APPLE_SPI_CTRL_RX_RESET | APPLE_SPI_CTRL_TX_RESET);
+
+	while (received < t->len) {
+		/* Keep no more than a FIFO's worth in flight so RX can't overflow */
+		while (sent < t->len && sent - received < APPLE_SPI_FIFO_DEPTH) {
+			reg_write(spi, APPLE_SPI_TXDATA, tx ? tx[sent] : 0xff);
+			sent++;
+		}
+
+		status = reg_read(spi, APPLE_SPI_STATUS);
+		level = FIELD_GET(APPLE_SPI_STATUS_LEVEL_RX, status);
+		if (!level) {
+			ret = apple_spi_s5l_wait(spi, poll);
+			if (ret) {
+				dev_err(&ctlr->dev, "transfer timed out (%u/%u bytes)\n",
+					received, t->len);
+				break;
+			}
+			reg_write(spi, APPLE_SPI_STATUS, APPLE_SPI_STATUS_S5L_CLEAR);
+			continue;
+		}
+
+		while (level-- && received < t->len) {
+			u8 val = reg_read(spi, APPLE_SPI_RXDATA);
+
+			if (rx)
+				rx[received] = val;
+			received++;
+		}
+	}
+
+	reg_write(spi, APPLE_SPI_STATUS, APPLE_SPI_STATUS_S5L_CLEAR);
+	reg_write(spi, APPLE_SPI_CTRL, 0);
+
+	return ret;
+}
+
 static int apple_spi_probe(struct platform_device *pdev)
 {
 	struct apple_spi *spi;
@@ -466,6 +607,7 @@ static int apple_spi_probe(struct platform_device *pdev)
 
 	spi = spi_controller_get_devdata(ctlr);
 	init_completion(&spi->done);
+	spi->s5l = (uintptr_t)of_device_get_match_data(&pdev->dev);
 
 	spi->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(spi->regs))
@@ -480,7 +622,8 @@ static int apple_spi_probe(struct platform_device *pdev)
 	if (irq < 0)
 		return irq;
 
-	ret = devm_request_irq(&pdev->dev, irq, apple_spi_irq, 0,
+	ret = devm_request_irq(&pdev->dev, irq,
+			       spi->s5l ? apple_spi_s5l_irq : apple_spi_irq, 0,
 			       dev_name(&pdev->dev), spi);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Unable to bind to interrupt\n");
@@ -488,10 +631,10 @@ static int apple_spi_probe(struct platform_device *pdev)
 	ctlr->bus_num = pdev->id;
 	ctlr->num_chipselect = 1;
 	ctlr->mode_bits = SPI_CPHA | SPI_CPOL | SPI_LSB_FIRST;
-	ctlr->bits_per_word_mask = SPI_BPW_RANGE_MASK(1, 32);
+	ctlr->bits_per_word_mask = spi->s5l ? SPI_BPW_MASK(8) : SPI_BPW_RANGE_MASK(1, 32);
 	ctlr->prepare_message = apple_spi_prepare_message;
 	ctlr->set_cs = apple_spi_set_cs;
-	ctlr->transfer_one = apple_spi_transfer_one;
+	ctlr->transfer_one = spi->s5l ? apple_spi_s5l_transfer_one : apple_spi_transfer_one;
 	ctlr->use_gpio_descriptors = true;
 	ctlr->auto_runtime_pm = true;
 
@@ -500,7 +643,10 @@ static int apple_spi_probe(struct platform_device *pdev)
 	if (ret < 0)
 		return ret;
 
-	apple_spi_init(spi);
+	if (spi->s5l)
+		apple_spi_s5l_init(spi);
+	else
+		apple_spi_init(spi);
 
 	ret = devm_spi_register_controller(&pdev->dev, ctlr);
 	if (ret < 0)
@@ -510,6 +656,7 @@ static int apple_spi_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id apple_spi_of_match[] = {
+	{ .compatible = "apple,t7000-spi", .data = (void *)true },
 	{ .compatible = "apple,t8103-spi", },
 	{ .compatible = "apple,spi", },
 	{}
