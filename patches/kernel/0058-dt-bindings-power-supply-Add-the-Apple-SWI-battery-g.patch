From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Mon, 19 Oct 2026 00:26:44 +0000
Subject: [PATCH 058/138] dt-bindings: power: supply: Add the Apple SWI battery
 gauge

The iPhone 6 battery has a bq27540 gauge that speaks HDQ over a single
wire driven by a SoC UART, handed over by the SN2400 charger.

Assisted-by: Claude:claude-opus-5-5
---
 .../power/supply/apple,t7000-swi-gauge.yaml   | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/apple,t7000-swi-gauge.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/apple,t7000-swi-gauge.yaml b/Documentation/devicetree/bindings/power/supply/apple,t7000-swi-gauge.yaml
new file mode 100644
index 000000000..b00921e35
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/apple,t7000-swi-gauge.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/apple,t7000-swi-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SWI battery gauge
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description:
+  The battery of the iPhone 6 has a TI bq27540 gas gauge that speaks HDQ
+  over a single wire. A SoC UART drives the wire, one UART frame per HDQ
+  bit. The wire goes through the SN2400 charger, which has to hand it to
+  the SoC before each access. The node describes the UART used this way.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: apple,t7000-swi-gauge
+
+  reg:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  apple,swi-master:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The charger that hands the wire over.
+
+required:
+  - compatible
+  - reg
+  - apple,swi-master
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    battery-gauge@a0d4000 {
+        compatible = "apple,t7000-swi-gauge";
+        reg = <0xa0d4000 0x4000>;
+        apple,swi-master = <&charger>;
+        power-supplies = <&charger>;
+    };
