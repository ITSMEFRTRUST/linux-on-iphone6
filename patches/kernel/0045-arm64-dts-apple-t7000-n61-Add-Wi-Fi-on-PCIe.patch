From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 16:26:24 +0000
Subject: [PATCH 045/138] arm64: dts: apple: t7000-n61: Add Wi-Fi on PCIe

The Wi-Fi half of the BCM4345 module is on PCIe port 1. PERST# is GPIO
77 and WL_REG_ON is PMU GPIO 10. The link is Gen1 and ASPM stays off.
The endpoint node selects the "apple,tempranillo" firmware files.

Not yet tested on hardware.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000-n61.dts | 40 +++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n61.dts b/arch/arm64/boot/dts/apple/t7000-n61.dts
index bc1ff8d8a..86dd7640f 100644
--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -54,6 +54,46 @@ &mca2 {
 	status = "okay";
 };
 
+&pcie {
+	status = "okay";
+};
+
+/*
+ * The PCIe driver and the DART driver are modules in the Wi-Fi bring-up
+ * config: the DART only answers once port 1 is enabled, so it has to be
+ * loaded after pcie-apple.
+ */
+&dart_apcie1 {
+	status = "okay";
+};
+
+/* ADT /arm-io/apcie/pci-bridge1: the Wi-Fi half of the BCM4345 module */
+&port01 {
+	/* ADT function-perst: GPIO 77 */
+	reset-gpios = <&pinctrl 77 GPIO_ACTIVE_LOW>;
+	/* ADT uart4/wlan function-reg_on: PMU GPIO 10 = WL_REG_ON */
+	pwren-gpios = <&pmic_gpio 10 GPIO_ACTIVE_HIGH>;
+	/* ADT maximum-link-speed */
+	max-link-speed = <1>;
+	/*
+	 * iOS needs special L1SS handling (acpie-l1ss-workaround) and
+	 * cannot touch config space in L1/L2: keep ASPM off.
+	 */
+	aspm-no-l0s;
+	aspm-no-l1;
+	aspm-no-l1ss;
+	/* CLKREQ# (GPIO 41) and DEVICE_WAKE (GPIO 200) are not used */
+	bus-range = <1 1>;
+	status = "okay";
+
+	wifi0: wifi@0,0 {
+		compatible = "pci14e4,43ab";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		/* ADT module-instance: brcmfmac4345b1-pcie.apple,tempranillo.* */
+		brcm,board-type = "apple,tempranillo";
+	};
+};
+
 &i2c0 {
 	/* Display PMU, only the touch analog supply switch is described */
 	display-pmu@27 {
