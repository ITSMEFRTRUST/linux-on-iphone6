+	while (done < filled) {
+		*(u32 *)(area + d->pos) =
+			readl_relaxed(mca->base + SHIM_RX_PORT + 4 * d->word);
+		d->word = (d->word + 1) % SHIM_PORT_WORDS;
+		d->pos += 4;
+		if (d->pos >= buf_bytes)
+			d->pos = 0;
 		done += 4;
 	}
 
