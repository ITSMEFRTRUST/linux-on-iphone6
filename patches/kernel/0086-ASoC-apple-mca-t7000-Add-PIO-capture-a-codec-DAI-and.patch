 	unsigned int free = shim_free(mca) & ~3;
 	unsigned int done = 0;
 	u8 *area = runtime->dma_area;
 
 	while (done < free) {
-		writel_relaxed(*(u32 *)(area + mca->pos),
-			       mca->base + SHIM_TX_PORT + 4 * mca->word);
-		mca->word = (mca->word + 1) % SHIM_PORT_WORDS;
-		mca->pos += 4;
-		if (mca->pos >= buf_bytes)
-			mca->pos = 0;
+		writel_relaxed(*(u32 *)(area + d->pos),
