From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Mon, 19 Oct 2026 01:20:27 +0000
Subject: [PATCH 063/138] dt-bindings: display: Add the Apple A8 (T7000)
 display pipe

The A8 display pipe is the same H7 IP as apple,h7-display-pipe, but
vblank comes from the ADP block itself and the bootloader leaves the
DSI host, panel and timing generator running, so the driver keeps that
state and scans out of the boot framebuffer carveout. Describe the ADP
and ADBE0 register blocks, the ADP interrupt, the two power domains and
the carveout.

Assisted-by: Claude:claude-opus-5-5
---
 .../display/apple,t7000-display-pipe.yaml     | 93 +++++++++++++++++++
 1 file changed, 93 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/apple,t7000-display-pipe.yaml

diff --git a/Documentation/devicetree/bindings/display/apple,t7000-display-pipe.yaml b/Documentation/devicetree/bindings/display/apple,t7000-display-pipe.yaml
new file mode 100644
index 000000000..9eed5422d
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/apple,t7000-display-pipe.yaml
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/apple,t7000-display-pipe.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A8 (T7000) display pipe
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description: |
+  The internal display controller of Apple A8 devices ("AppleH7DisplayPipe"
+  in iOS). It is the same H7 display pipe IP as apple,h7-display-pipe, but
+  vblank and flip completion are reported by the ADP block itself, and the
+  bootloader leaves the DSI host, the panel and the timing generator running.
+  The driver keeps that state and scans out of the boot framebuffer
+  carveout, which the bootloader has already mapped in the display DART.
+
+properties:
+  compatible:
+    const: apple,t7000-display-pipe
+
+  reg:
+    items:
+      - description: ADP block (layers, blending, parameter FIFO, interrupts)
+      - description: ADBE0 back end (timing generator)
+
+  reg-names:
+    items:
+      - const: adp
+      - const: adbe
+
+  interrupts:
+    items:
+      - description: ADP interrupt (vblank, packet done, errors)
+
+  interrupt-names:
+    items:
+      - const: adp
+
+  power-domains:
+    items:
+      - description: Display pipe power domain
+      - description: MIPI DSI power domain
+
+  memory-region:
+    maxItems: 1
+    description:
+      The boot framebuffer carveout (ADT /vram). Scanout buffers are allocated
+      from it.
+
+  width-mm:
+    description: Physical width of the panel in millimetres.
+
+  height-mm:
+    description: Physical height of the panel in millimetres.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - power-domains
+  - memory-region
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        display-pipe@206200000 {
+            compatible = "apple,t7000-display-pipe";
+            reg = <0x2 0x06200000 0x0 0x8000>,
+                  <0x2 0x06400000 0x0 0x8000>;
+            reg-names = "adp", "adbe";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 103 IRQ_TYPE_LEVEL_HIGH>;
+            interrupt-names = "adp";
+            power-domains = <&ps_disp0>, <&ps_mipi_dsi>;
+            memory-region = <&disp0_vram>;
+            width-mm = <58>;
+            height-mm = <104>;
+        };
+    };
+...
