From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Thu, 22 Oct 2026 02:35:16 +0000
Subject: [PATCH 108/138] arm64: dts: apple: t7000-n61: Add the PMU event
 interrupts

Describe the D2186 event controller (AP GPIO 106, level low per the ADT)
and use it for the RTC alarm (event 88) and the SN2400's VBUS detect
(event 3), both as wake sources. Left disabled on the other iPhone 6
boards until checked there.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000-6.dtsi  | 16 +++++++++++++++-
 arch/arm64/boot/dts/apple/t7000-n61.dts | 17 +++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t7000-6.dtsi b/arch/arm64/boot/dts/apple/t7000-6.dtsi
index 7aaa664e1..e5aa57c88 100644
--- a/arch/arm64/boot/dts/apple/t7000-6.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000-6.dtsi
@@ -79,7 +79,21 @@ pmic_gpio: gpio@400 {
 			#gpio-cells = <2>;
 		};
 
-		rtc@5c0 {
+		/*
+		 * Event interrupts: 0x50 events (clear on read), 0x60 status,
+		 * 0x70 masks. The PMU signals them on AP GPIO 106 (ADT
+		 * "pmu,d2186" interrupts <106 1>).
+		 */
+		pmic_irq: interrupt-controller@50 {
+			compatible = "apple,adi-pmic-irq";
+			reg = <0x50 0x2d>;
+			interrupts-extended = <&pinctrl 106 IRQ_TYPE_LEVEL_LOW>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			status = "disabled";
+		};
+
+		pmic_rtc: rtc@5c0 {
 			compatible = "apple,adi-pmic-rtc", "apple,amber-pmic-rtc";
 			reg = <0x5c0 0x10>;
 			nvmem-cells = <&rtc_offset>;
diff --git a/arch/arm64/boot/dts/apple/t7000-n61.dts b/arch/arm64/boot/dts/apple/t7000-n61.dts
index c0e88770f..30e42fa5b 100644
--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -209,6 +209,10 @@ haptics@5a {
 	charger: charger@75 {
 		compatible = "ti,sn2400";
 		reg = <0x75>;
+		/* PMU event 3 = VBUS detect (iOS wake reason "usb") */
+		interrupts-extended = <&pmic_irq 3 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "vbus";
+		wakeup-source;
 		input-current-limit-microamp = <500000>;
 		constant-charge-current-max-microamp = <1000000>;
 	};
@@ -379,6 +383,19 @@ &pmic_gpio {
 	gpio-reserved-ranges = <11 1>;
 };
 
+/*
+ * PMU events (iOS AppleD2186PMU): 3 = VBUS detect, 24 + n = PMU GPIO n
+ * (0 = SN2400 INT, 6 = WLAN host wake, 9 = BT host wake), 88 = RTC alarm.
+ */
+&pmic_irq {
+	status = "okay";
+};
+
+&pmic_rtc {
+	interrupts-extended = <&pmic_irq 88 IRQ_TYPE_EDGE_RISING>;
+	wakeup-source;
+};
+
 &serial8 {
 	status = "okay";
 };
