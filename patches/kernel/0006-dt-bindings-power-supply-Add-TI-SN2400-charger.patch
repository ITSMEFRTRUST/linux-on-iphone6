From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:49:42 +0000
Subject: [PATCH 006/138] dt-bindings: power: supply: Add TI SN2400 charger

The SN2400 is a USB charger made by TI for Apple and used in the
iPhone 6.

Assisted-by: Claude:claude-opus-5-5
---
 .../bindings/power/supply/ti,sn2400.yaml      | 56 +++++++++++++++++++
 1 file changed, 56 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml b/Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml
new file mode 100644
index 000000000..c4c5ba5f5
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/ti,sn2400.yaml
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/ti,sn2400.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: TI SN2400 USB charger
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description:
+  USB input charger made by TI for Apple, used in the iPhone 6.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: ti,sn2400
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  input-current-limit-microamp:
+    description: Input current limit, 0 suspends the input.
+    minimum: 0
+    maximum: 2000000
+    default: 500000
+
+  constant-charge-current-max-microamp:
+    description: Charge current.
+    maximum: 2550000
+    default: 1000000
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        charger@75 {
+            compatible = "ti,sn2400";
+            reg = <0x75>;
+            input-current-limit-microamp = <500000>;
+        };
+    };
