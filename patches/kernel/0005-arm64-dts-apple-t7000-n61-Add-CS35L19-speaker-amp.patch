From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:44:07 +0000
Subject: [PATCH 005/138] arm64: dts: apple: t7000-n61: Add CS35L19 speaker amp

The speaker amplifier is a CS35L19 at 0x40 on i2c1, held in reset by
GPIO 49. Configure it with the values from the "speaker-config" property
of the iOS device tree.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000-n61.dts | 29 +++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n61.dts b/arch/arm64/boot/dts/apple/t7000-n61.dts
index 5eec5926c..158968f07 100644
--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -27,4 +27,33 @@ haptics@5a {
 		vib-rated-mv = <2140>;
 		vib-overdrive-mv = <3320>;
 	};
+
+	/*
+	 * Values from the "speaker-config" property of the iOS device tree.
+	 * The IRQ (GPIO 47) is left out until its polarity is known; VA/VP
+	 * come from the PMU and are not described yet.
+	 */
+	speaker-amp@40 {
+		compatible = "cirrus,cs35l19";
+		reg = <0x40>;
+		reset-gpios = <&pinctrl 49 GPIO_ACTIVE_HIGH>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Speaker";
+
+		cirrus,boost-ctl = <43>;		/* 7.5 V */
+		cirrus,boost-ipk = <2756250>;
+		cirrus,boost-slew-step = <2>;
+		cirrus,boost-coeffs = /bits/ 8 <0x8a 0x10 0x73 0x03>;
+		cirrus,trim = /bits/ 8 <0x05 0x04 0xd0>;
+
+		cirrus,hg-algo {
+			cirrus,mem-depth = <3>;
+			cirrus,release-rate = <128>;
+			cirrus,hd-rm = <20>;
+			cirrus,ldo-thld = <5>;
+			cirrus,ldo-entry-delay = <4>;
+			cirrus,vp-hg = <9>;
+			cirrus,vp-hg-va = <1>;
+		};
+	};
 };
