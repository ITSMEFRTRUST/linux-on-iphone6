diff --git a/drivers/media/platform/apple/isp-t7000/isp-main.c b/drivers/media/platform/apple/isp-t7000/isp-main.c
new file mode 100644
index 000000000..d97ec8bc1
--- /dev/null
+++ b/drivers/media/platform/apple/isp-t7000/isp-main.c
@@ -0,0 +1,212 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple A8 (T7000) ISP bring-up test driver: module entry + stage runner.
+ *
+ * insmod apple-isp.ko stage=N runs stages 1..N and stays loaded; rmmod (or any
+ * failure) unwinds in reverse: CPU halt, DART off, power off what we turned on,
+ * then free memory. stage=0 (default) only logs the PMGR state; dry_run=1 only
+ * reads registers (and peeks at the firmware file), it never writes anything.
+ *
+ *  1 power-up (PMGR media, isp) + version read     6 boot stage 3 (channel table)
+ *  2 bridge settings + clock enable                7 mailbox + rings, poll worker
+ *  3 mini DART + firmware into a DART surface      8 PRINT_ENABLE + START
+ *  4 ISP CPU start, wait for the wake magic        9 CONFIG_GET + BUILDINFO
+ *  5 boot stage 2 (IPC pool + boot args)
+ */
+#include <linux/dma-mapping.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#include "isp.h"
+
+static int stage;
+module_param(stage, int, 0444);
+MODULE_PARM_DESC(stage, "run stages 1..N and stay loaded (0 = only log PMGR state)");
+int isp_dry_run;
+module_param_named(dry_run, isp_dry_run, int, 0444);
+MODULE_PARM_DESC(dry_run, "1 = only read + log registers (ISP window only if already powered)");
+int isp_irq_en;
+module_param_named(irq, isp_irq_en, int, 0444);
+MODULE_PARM_DESC(irq, "1 = use AIC IRQ 91 for the mailbox (default: poll)");
+int isp_sens;
+module_param_named(sens, isp_sens, int, 0444);
+MODULE_PARM_DESC(sens, "1 = also power ps_ispsens0/1 (iOS does; default off)");
+int isp_smmu_en;
+module_param_named(smmu_en, isp_smmu_en, int, 0444);
+MODULE_PARM_DESC(smmu_en, "1 = also set SMMU+0xc byte[sid] |= 0x80 like iOS (default: SMMU read-only)");
+int isp_graceful = 1;
+module_param_named(graceful, isp_graceful, int, 0444);
+MODULE_PARM_DESC(graceful, "1 = STOP + POWER_DOWN handshake before halting a booted fw");
+uint isp_fw_iova;
+module_param_named(fw_iova, isp_fw_iova, uint, 0444);
+MODULE_PARM_DESC(fw_iova, "DART IOVA of the firmware (default 0: fw-relative == absolute)");
+uint isp_dart_sids = 0xf;
+module_param_named(dart_sids, isp_dart_sids, uint, 0444);
+MODULE_PARM_DESC(dart_sids, "DART stream mask to translate (default 0xf = all 4)");
+uint isp_platform_id = 0x2a;
+module_param_named(platform_id, isp_platform_id, uint, 0444);
+MODULE_PARM_DESC(platform_id, "boot-args platform id (ADT sensor-type, default 0x2a)");
+uint isp_poll_ms = 50;
+module_param_named(poll_ms, isp_poll_ms, uint, 0444);
+MODULE_PARM_DESC(poll_ms, "ring poll interval once the fw is up");
+uint isp_boot_timeout_ms = 10000;
+module_param_named(boot_timeout_ms, isp_boot_timeout_ms, uint, 0444);
+MODULE_PARM_DESC(boot_timeout_ms, "timeout of each boot handshake (iOS: 10 s)");
+uint isp_cmd_timeout_ms = 2000;
+module_param_named(cmd_timeout_ms, isp_cmd_timeout_ms, uint, 0444);
+MODULE_PARM_DESC(cmd_timeout_ms, "timeout of one fw command (iOS: 2 s)");
+uint isp_max_shared_mb = 64;
+module_param_named(max_shared_mb, isp_max_shared_mb, uint, 0444);
+MODULE_PARM_DESC(max_shared_mb, "cap on SHAREDMALLOC memory");
+
+static struct t7000_isp *the_isp;
+
+static int isp_stage_power(struct t7000_isp *isp)
+{
+	return isp_power_on(isp);
+}
+
+static int (*const isp_stages[])(struct t7000_isp *) = {
+	NULL,
+	isp_stage_power,	/* 1 */
+	isp_stage_clocks,	/* 2 */
+	isp_stage_fw,		/* 3 */
+	isp_stage_cpu,		/* 4 */
+	isp_stage_args,		/* 5 */
+	isp_stage_chans,	/* 6 */
+	isp_stage_mbox,		/* 7 */
+	isp_stage_start,	/* 8 */
+	isp_stage_query,	/* 9 */
+};
+
+/* Reverse unwind. Memory is freed only after the ISP is powered off. */
+static void isp_teardown(struct t7000_isp *isp)
+{
+	dev_info(isp->dev, "teardown from stage %d\n", isp->done);
+	isp_ipc_stop(isp);
+	mutex_lock(&isp->lock);
+	if (isp->fw_up && isp_graceful)
+		isp_fw_shutdown(isp);
+	if (isp->cpu_started)
+		isp_cpu_stop(isp);
+	if (isp->dart_on)
+		isp_dart_fini(isp);
+	isp_power_off(isp);
+	isp_surf_free_all(isp);
+	isp->done = 0;
+	mutex_unlock(&isp->lock);
+	isp_pmgr_log(isp, "after teardown");
+}
+
+static int isp_run(struct t7000_isp *isp)
+{
+	int n, ret;
+
+	if (stage < 0 || stage >= ARRAY_SIZE(isp_stages)) {
+		dev_err(isp->dev, "stage=%d out of range 0..%zu\n", stage,
+			ARRAY_SIZE(isp_stages) - 1);
+		return -EINVAL;
+	}
+	for (n = 1; n <= stage; n++) {
+		dev_info(isp->dev, "stage %d: start\n", n);
+		if (n > 1 && isp->isp_was_on) {
+			dev_err(isp->dev, "ps_isp was already on at load: someone else owns it, refusing writes\n");
+			return -EBUSY;
+		}
+		mutex_lock(&isp->lock);
+		ret = isp_stages[n](isp);
+		mutex_unlock(&isp->lock);
+		if (ret) {
+			dev_err(isp->dev, "stage %d: FAILED (%d), unwinding\n", n, ret);
+			return ret;
+		}
+		isp->done = n;
+		dev_info(isp->dev, "stage %d: done\n", n);
+	}
+	return 0;
+}
+
+static int __init isp_init(void)
+{
+	struct platform_device_info pinfo = {
+		.name = "apple-isp-t7000",
+		.id = PLATFORM_DEVID_NONE,
+		.dma_mask = DMA_BIT_MASK(64),
+	};
+	struct t7000_isp *isp;
+	int ret;
+
+	isp = kzalloc(sizeof(*isp), GFP_KERNEL);
+	if (!isp)
+		return -ENOMEM;
+	mutex_init(&isp->lock);
+	INIT_LIST_HEAD(&isp->surfs);
+	atomic_set(&isp->irq_count, 0);
+	isp->irq = -1;
+
+	isp->pdev = platform_device_register_full(&pinfo);
+	if (IS_ERR(isp->pdev)) {
+		ret = PTR_ERR(isp->pdev);
+		goto err_free;
+	}
+	isp->dev = &isp->pdev->dev;
+	dev_info(isp->dev, "load: stage=%d dry_run=%d irq=%d sens=%d smmu_en=%d fw_iova=0x%x dart_sids=0x%x platform_id=0x%x\n",
+		 stage, isp_dry_run, isp_irq_en, isp_sens, isp_smmu_en,
+		 isp_fw_iova, isp_dart_sids, isp_platform_id);
+
+	ret = -ENOMEM;
+	isp->pmgr = ioremap_np(PMGR_PS_PHYS, PMGR_PS_SIZE);
+	isp->regs = ioremap_np(ISP_PHYS_BASE, ISP_PHYS_SIZE);
+	if (!isp->pmgr || !isp->regs)
+		goto err_unmap;
+
+	isp_pmgr_log(isp, "load");
+	if (isp_dry_run) {
+		isp_dry_read(isp);
+		goto ok;
+	}
+	if (isp_fw_iova & 0xfff || isp_fw_iova >= 0x30000000 || !isp_dart_sids ||
+	    isp_dart_sids > 0xf) {
+		dev_err(isp->dev, "bad fw_iova/dart_sids\n");
+		ret = -EINVAL;
+		goto err_unmap;
+	}
+	ret = isp_run(isp);
+	if (ret) {
+		isp_teardown(isp);
+		goto err_unmap;
+	}
+ok:
+	dev_info(isp->dev, "loaded, stages done: %d (rmmod unwinds)\n", isp->done);
+	the_isp = isp;
+	return 0;
+
+err_unmap:
+	if (isp->regs)
+		iounmap(isp->regs);
+	if (isp->pmgr)
+		iounmap(isp->pmgr);
+	platform_device_unregister(isp->pdev);
+err_free:
+	kfree(isp);
+	return ret;
+}
+
+static void __exit isp_exit(void)
+{
+	struct t7000_isp *isp = the_isp;
+
+	if (!isp_dry_run)
+		isp_teardown(isp);
+	iounmap(isp->regs);
+	iounmap(isp->pmgr);
+	dev_info(isp->dev, "unloaded\n");
+	platform_device_unregister(isp->pdev);
+	kfree(isp);
+}
+
+module_init(isp_init);
+module_exit(isp_exit);
+MODULE_DESCRIPTION("Apple A8 (T7000) ISP bring-up test driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/apple/isp-t7000/isp-pwr.c b/drivers/media/platform/apple/isp-t7000/isp-pwr.c
new file mode 100644
index 000000000..cef0f9159
--- /dev/null
+++ b/drivers/media/platform/apple/isp-t7000/isp-pwr.c
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple A8 (T7000) ISP: PMGR power (stage 1) and bridge/clock setup (stage 2).
+ *
+ * Rule: the ISP window is touched only after ps_media and ps_isp read ACTUAL == 0xf.
+ * Reading it gated can wedge the fabric.
+ */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/platform_device.h>
+
+#include "isp.h"
+
+static u32 ps_rd(struct t7000_isp *isp, u32 off)
+{
+	return readl(isp->pmgr + off);
+}
+
+static bool ps_is_on(u32 v)
+{
+	return FIELD_GET(PS_ACTUAL, v) == PS_ACTIVE;
+}
+
+void isp_pmgr_log(struct t7000_isp *isp, const char *when)
+{
+	dev_info(isp->dev, "pmgr %s: media 0x%08x isp 0x%08x ispsens0 0x%08x ispsens1 0x%08x\n",
+		 when, ps_rd(isp, PMGR_PS_MEDIA), ps_rd(isp, PMGR_PS_ISP),
+		 ps_rd(isp, PMGR_PS_ISPSENS0), ps_rd(isp, PMGR_PS_ISPSENS1));
+}
+
+static int ps_set(struct t7000_isp *isp, u32 off, const char *name, u32 state)
+{
+	u32 v = ps_rd(isp, off);
+	int ret;
+
+	v &= ~(PS_AUTO_ENABLE | PS_FLAGS | PS_TARGET);
+	v |= FIELD_PREP(PS_TARGET, state);
+	writel(v, isp->pmgr + off);
+	ret = readl_poll_timeout(isp->pmgr + off, v,
+				 FIELD_GET(PS_ACTUAL, v) == state, 10, 100000);
+	if (ret)
+		dev_err(isp->dev, "pmgr %s: timeout (100 ms) waiting for ACTUAL == 0x%x, reg 0x%08x\n",
+			name, state, v);
+	else
+		dev_info(isp->dev, "pmgr %s: -> 0x%x ok, reg 0x%08x\n", name, state, v);
+	return ret;
+}
+
+/* Power one domain on unless it already is; *ours tells whether we did it. */
+static int ps_on(struct t7000_isp *isp, u32 off, const char *name, bool *ours)
+{
+	u32 v = ps_rd(isp, off);
+	int ret;
+
+	*ours = false;
+	if (!ps_is_on(v)) {
+		*ours = true;	/* even on timeout: the target was changed, undo it */
+		ret = ps_set(isp, off, name, PS_ACTIVE);
+		if (ret)
+			return ret;
+		v = ps_rd(isp, off);
+	} else {
+		dev_info(isp->dev, "pmgr %s: already on (0x%08x), will leave it on\n", name, v);
+	}
+	if (v & (PS_RESET | PS_DEV_DISABLE)) {
+		dev_err(isp->dev, "pmgr %s: RESET/DEV_DISABLE set (0x%08x), refusing\n", name, v);
+		return -EIO;
+	}
+	return 0;
+}
+
+int isp_power_on(struct t7000_isp *isp)
+{
+	int ret;
+
+	isp->isp_was_on = ps_is_on(ps_rd(isp, PMGR_PS_ISP));
+	ret = ps_on(isp, PMGR_PS_MEDIA, "media", &isp->on_media);
+	if (ret)
+		return ret;
+	ret = ps_on(isp, PMGR_PS_ISP, "isp", &isp->on_isp);
+	if (ret)
+		return ret;
+	if (isp_sens) {
+		ret = ps_on(isp, PMGR_PS_ISPSENS0, "ispsens0", &isp->on_sens0);
+		if (!ret)
+			ret = ps_on(isp, PMGR_PS_ISPSENS1, "ispsens1", &isp->on_sens1);
+		if (ret)
+			return ret;
+	}
+	isp->version = isp_rd(isp, ISP_VERSION);
+	dev_info(isp->dev, "version reg (+0xa0000) = 0x%08x -> rev %u%s\n",
+		 isp->version, isp->version >> 16,
+		 (isp->version >> 16) == 4 ? "" : " (only rev 4 is implemented; stage 2+ will refuse)");
+	isp->version >>= 16;
+	isp_log_window(isp, "after power-on");
+	return 0;
+}
+
+void isp_power_off(struct t7000_isp *isp)
+{
+	if (isp->on_sens1) {
+		ps_set(isp, PMGR_PS_ISPSENS1, "ispsens1", PS_PWRGATE);
+		isp->on_sens1 = false;
+	}
+	if (isp->on_sens0) {
+		ps_set(isp, PMGR_PS_ISPSENS0, "ispsens0", PS_PWRGATE);
+		isp->on_sens0 = false;
+	}
+	if (isp->on_isp) {
+		ps_set(isp, PMGR_PS_ISP, "isp", PS_PWRGATE);
+		isp->on_isp = false;
+	}
+	if (isp->on_media) {
+		ps_set(isp, PMGR_PS_MEDIA, "media", PS_PWRGATE);
+		isp->on_media = false;
+	}
+}
+
+void isp_log_window(struct t7000_isp *isp, const char *when)
+{
+	dev_info(isp->dev, "%s: gpio0-7 %08x %08x %08x %08x %08x %08x %08x %08x\n", when,
+		 isp_rd(isp, ISP_GPIO(0)), isp_rd(isp, ISP_GPIO(1)), isp_rd(isp, ISP_GPIO(2)),
+		 isp_rd(isp, ISP_GPIO(3)), isp_rd(isp, ISP_GPIO(4)), isp_rd(isp, ISP_GPIO(5)),
+		 isp_rd(isp, ISP_GPIO(6)), isp_rd(isp, ISP_GPIO(7)));
+	dev_info(isp->dev, "%s: ctrl %08x fwbase %08x win %08x %08x %08x %08x %08x mbox p%08x e%08x\n",
+		 when, isp_rd(isp, ISP_CTRL_V34), isp_rd(isp, ISP_FW_BASE),
+		 isp_rd(isp, ISP_WIN_0C), isp_rd(isp, ISP_WIN_10), isp_rd(isp, ISP_WIN_14),
+		 isp_rd(isp, ISP_WIN_18), isp_rd(isp, ISP_WIN_1C),
+		 isp_rd(isp, ISP_MBOX_PENDING), isp_rd(isp, ISP_MBOX_ENABLE));
+	dev_info(isp->dev, "%s: clken %08x bridge 1c=%08x 20=%08x 48=%08x 1000=%08x tl-out 44=%08x 68=%08x\n",
+		 when, isp_rd(isp, ISP_CLOCK_EN), isp_rd(isp, 0x1c), isp_rd(isp, 0x20),
+		 isp_rd(isp, 0x48), isp_rd(isp, 0x1000), isp_rd(isp, ISP_TLIMIT0_OUT),
+		 isp_rd(isp, ISP_TLIMIT1_OUT));
+}
+
+/* PMGR bridge-settings-6 (= ISP, PMGR reg index 8 = 0x5b00000), applied by iOS PMGR on power-up */
+static const u32 isp_bridge6[][2] = {
+	{ 0x1c, 0x80000004 }, { 0x20, 0x80240010 },
+	{ 0x48, 0x2020 }, { 0x4c, 0x2020 }, { 0x50, 0x2020 }, { 0x54, 0x2020 },
+	{ 0x58, 0x2020 }, { 0x5c, 0x2020 }, { 0x60, 0x2020 }, { 0x64, 0x2020 },
+	{ 0x1000, 0xc00f000f }, { 0x1008, 0xc00f000f },
+	{ 0x21000, 0x808 }, { 0x21004, 0x808 },
+};
+
+int isp_stage_clocks(struct t7000_isp *isp)
+{
+	int i;
+
+	if (isp->version != 4) {
+		dev_err(isp->dev, "rev %u: only rev 4 is implemented\n", isp->version);
+		return -ENODEV;
+	}
+	for (i = 0; i < ARRAY_SIZE(isp_bridge6); i++) {
+		u32 off = isp_bridge6[i][0], old = isp_rd(isp, off);
+
+		isp_wr(isp, off, isp_bridge6[i][1]);
+		dev_info(isp->dev, "bridge +0x%05x: 0x%08x -> 0x%08x (readback 0x%08x)\n",
+			 off, old, isp_bridge6[i][1], isp_rd(isp, off));
+	}
+	isp_wr(isp, ISP_CLOCK_EN, 1);
+	dev_info(isp->dev, "clock enable +0x20080 = 1 (readback 0x%08x)\n",
+		 isp_rd(isp, ISP_CLOCK_EN));
+	isp_log_window(isp, "after stage 2");
+	return 0;
+}
+
+/* dry_run: reads only. The window is read only if media + isp are already on. */
+void isp_dry_read(struct t7000_isp *isp)
+{
+	if (ps_is_on(ps_rd(isp, PMGR_PS_MEDIA)) && ps_is_on(ps_rd(isp, PMGR_PS_ISP))) {
+		isp->version = isp_rd(isp, ISP_VERSION);
+		dev_info(isp->dev, "dry_run: version reg 0x%08x (rev %u)\n",
+			 isp->version, isp->version >> 16);
+		isp_log_window(isp, "dry_run");
+		isp_dart_log(isp, "dry_run");
+	} else {
+		dev_info(isp->dev, "dry_run: ps_media/ps_isp not both on: not reading the ISP window\n");
+	}
+	isp_fw_peek(isp);
+}
