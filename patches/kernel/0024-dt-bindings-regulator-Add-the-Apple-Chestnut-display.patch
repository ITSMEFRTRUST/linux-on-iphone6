From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 00:29:26 +0000
Subject: [PATCH 024/138] dt-bindings: regulator: Add the Apple Chestnut
 display PMU

Chestnut is the display PMU on the i2c0 bus of the iPhone 6. Only the
LDO that switches the touch controller's analog supply is described.

Assisted-by: Claude:claude-opus-5-5
---
 .../bindings/regulator/apple,chestnut.yaml    | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/apple,chestnut.yaml

diff --git a/Documentation/devicetree/bindings/regulator/apple,chestnut.yaml b/Documentation/devicetree/bindings/regulator/apple,chestnut.yaml
new file mode 100644
index 000000000..9a2862cf7
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/apple,chestnut.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/apple,chestnut.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Chestnut display PMU
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description:
+  The Chestnut display PMU is an I2C attached PMU found in Apple iPhones with
+  A8 and similar SoCs. It provides the LCD supplies, which are set up by the
+  bootloader and not described here, and the analog supply of the touch
+  controller. The latter is a switch that has no voltage control.
+
+properties:
+  compatible:
+    const: apple,chestnut
+
+  reg:
+    maxItems: 1
+
+  regulators:
+    type: object
+    description: Regulators provided by the PMU.
+
+    properties:
+      ldo2:
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+        description: Touch controller analog supply switch.
+
+    additionalProperties: false
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        display-pmu@27 {
+            compatible = "apple,chestnut";
+            reg = <0x27>;
+
+            regulators {
+                chestnut_ldo2: ldo2 {
+                    regulator-name = "chestnut-ldo2";
+                };
+            };
+        };
+    };
