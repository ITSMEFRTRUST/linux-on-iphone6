From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sat, 17 Oct 2026 23:58:23 +0000
Subject: [PATCH 021/138] arm64: dts: apple: t7000: Add the SPI controllers

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000.dtsi | 50 ++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000.dtsi b/arch/arm64/boot/dts/apple/t7000.dtsi
index c93e65851..ec40f9858 100644
--- a/arch/arm64/boot/dts/apple/t7000.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000.dtsi
@@ -26,6 +26,17 @@ clkref: clock-ref {
 		clock-output-names = "clkref";
 	};
 
+	/*
+	 * SPI reference: arm-io "clock-frequencies"[id - 256] for the SPI
+	 * clock-ids 301-303 is 60 MHz in the iOS device tree.
+	 */
+	clk_spi: clock-spi {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <60000000>;
+		clock-output-names = "clk_spi";
+	};
+
 	/* 2.4 GHz / 7, per the iOS device tree and AppleS5L8960XNCO */
 	nco_clkref: clock-ref-nco {
 		compatible = "fixed-clock";
@@ -127,6 +138,45 @@ cpufreq: performance-controller@202220000 {
 			#performance-domain-cells = <0>;
 		};
 
+		spi1: spi@20a084000 {
+			compatible = "apple,t7000-spi";
+			reg = <0x2 0x0a084000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 153 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_spi>;
+			/* TODO: pinctrl; the pins are muxed by iBoot for now */
+			power-domains = <&ps_spi1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		spi2: spi@20a088000 {
+			compatible = "apple,t7000-spi";
+			reg = <0x2 0x0a088000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 154 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_spi>;
+			/* TODO: pinctrl; the pins are muxed by iBoot for now */
+			power-domains = <&ps_spi2>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
+		spi3: spi@20a08c000 {
+			compatible = "apple,t7000-spi";
+			reg = <0x2 0x0a08c000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 155 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_spi>;
+			/* TODO: pinctrl; the pins are muxed by iBoot for now */
+			power-domains = <&ps_spi3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		ans: block@208040000 {
 			compatible = "apple,t7000-ans", "apple,s5l8960x-ans";
 			reg = <0x2 0x08040000 0x0 0x1000>;
