+/*
+ * CS35L19 rev B0 and later need a trim, as applied by the iPhone 6
+ * firmware; the registers are undocumented. Registers 0x46, 0x54 and 0x66
+ * are board specific and only written when "cirrus,trim" is present.
+ */
+static int cs35l19_apply_patch(struct cs35l33_private *cs35l33,
+			       unsigned int rev)
+{
+	struct cs35l33_pdata *pdata = &cs35l33->pdata;
+	struct reg_sequence patch[11];
+	int n = 0;
+
+#define CS35L19_PATCH(r, v) (patch[n++] = (struct reg_sequence){ (r), (v) })
+	if (rev >= CS35L19_TRIM_REV) {
+		CS35L19_PATCH(0x00, 0x99);
+		CS35L19_PATCH(0x45, 0x3F);
+		if (pdata->set_trim)
+			CS35L19_PATCH(0x46, pdata->trim[0]);
+		CS35L19_PATCH(0x51, 0xFF);
+		CS35L19_PATCH(0x59, 0x0A);
+		CS35L19_PATCH(0x6B, 0x20);
+		if (pdata->set_trim)
+			CS35L19_PATCH(0x54, pdata->trim[1]);
+		CS35L19_PATCH(0x00, 0x00);
+	}
+	if (pdata->set_trim) {
+		CS35L19_PATCH(0x00, 0x99);
+		CS35L19_PATCH(0x66, pdata->trim[2]);
+		CS35L19_PATCH(0x00, 0x00);
+	}
+#undef CS35L19_PATCH
+
+	if (!n)
+		return 0;
+
+	return regmap_register_patch(cs35l33->regmap, patch, n);
+}
