From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 17:54:12 +0000
Subject: [PATCH 049/138] iommu: io-pgtable-dart: Use the S5L8960X descriptor
 layout

The A8 apcie DART rejects the T8020 descriptor layout: with paddr|VALID
table entries every walk ends in 'NO PMD'. Table entries need bits 1:0 =
0b11, and leaves need 0b11 without the subpage range in bits 63:40
(otherwise 'NO PTE'). With this, BCM4345 Wi-Fi on PCIe comes up through
dart-apcie1 (wlan0, firmware loaded, MSIs delivered).

s5l_fmt (writable) can override the layout for other S5L8960X DARTs.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/iommu/apple-dart.c      |  2 ++
 drivers/iommu/io-pgtable-dart.c | 29 ++++++++++++++++++++++++++---
 include/linux/io-pgtable.h      |  1 +
 3 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 2753b3eb9..2d6c4aecb 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -722,6 +722,8 @@ static int apple_dart_finalize_domain(struct apple_dart_domain *dart_domain,
 		.coherent_walk = 1,
 		.iommu_dev = dart->dev,
 	};
+	if (dart->hw->type == DART_S5L8960X)
+		pgtbl_cfg.quirks |= IO_PGTABLE_QUIRK_APPLE_DART_S5L;
 
 	dart_domain->pgtbl_ops = alloc_io_pgtable_ops(dart->hw->fmt, &pgtbl_cfg,
 						      &dart_domain->domain);
diff --git a/drivers/iommu/io-pgtable-dart.c b/drivers/iommu/io-pgtable-dart.c
index cbc5d6aa2..93fbbc493 100644
--- a/drivers/iommu/io-pgtable-dart.c
+++ b/drivers/iommu/io-pgtable-dart.c
@@ -18,6 +18,7 @@
 #include <linux/bitops.h>
 #include <linux/io-pgtable.h>
 #include <linux/kernel.h>
+#include <linux/moduleparam.h>
 #include <linux/sizes.h>
 #include <linux/slab.h>
 #include <linux/types.h>
@@ -63,6 +64,18 @@
 /* marks PTE as valid */
 #define APPLE_DART_PTE_VALID		BIT(0)
 
+/*
+ * S5L8960X-style DARTs (A7/A8) walk ARM-like descriptors: both table entries
+ * and leaves need bits 1:0 = 0b11, and a leaf with the T8020 subpage range in
+ * bits 63:40 is rejected ("NO PTE"). Verified on the A8 apcie DART.
+ * Debug override: bit 0 = tables get bit 1, bit 1 = leaves without bit 1,
+ * bit 2 = leaves without the subpage range.
+ */
+#define APPLE_DART0_PTE_TABLE		BIT(1)
+static unsigned int s5l_fmt = 0x5;
+module_param(s5l_fmt, uint, 0644);
+MODULE_PARM_DESC(s5l_fmt, "S5L8960X DART descriptor format (debug)");
+
 /* IOPTE accessors */
 #define iopte_deref(pte, d) __va(iopte_to_paddr(pte, d))
 
@@ -78,6 +91,11 @@ struct dart_io_pgtable {
 
 typedef u64 dart_iopte;
 
+static bool dart_is_s5l(struct dart_io_pgtable *data)
+{
+	return data->iop.cfg.quirks & IO_PGTABLE_QUIRK_APPLE_DART_S5L;
+}
+
 
 static dart_iopte paddr_to_iopte(phys_addr_t paddr,
 				     struct dart_io_pgtable *data)
@@ -126,8 +144,10 @@ static int dart_init_pte(struct dart_io_pgtable *data,
 		}
 
 	/* subpage protection: always allow access to the entire page */
-	pte |= FIELD_PREP(APPLE_DART_PTE_SUBPAGE_START, 0);
-	pte |= FIELD_PREP(APPLE_DART_PTE_SUBPAGE_END, 0xfff);
+	if (!dart_is_s5l(data) || !(s5l_fmt & 4)) {
+		pte |= FIELD_PREP(APPLE_DART_PTE_SUBPAGE_START, 0);
+		pte |= FIELD_PREP(APPLE_DART_PTE_SUBPAGE_END, 0xfff);
+	}
 
 	pte |= APPLE_DART_PTE_VALID;
 
@@ -145,6 +165,8 @@ static dart_iopte dart_install_table(dart_iopte *table,
 	dart_iopte old, new;
 
 	new = paddr_to_iopte(__pa(table), data) | APPLE_DART_PTE_VALID;
+	if (dart_is_s5l(data) && (s5l_fmt & 1))
+		new |= APPLE_DART0_PTE_TABLE;
 
 	/*
 	 * Ensure the table itself is visible before its PTE can be.
@@ -205,7 +227,8 @@ static dart_iopte dart_prot_to_pte(struct dart_io_pgtable *data,
 	dart_iopte pte = 0;
 
 	if (data->iop.fmt == APPLE_DART) {
-		pte |= APPLE_DART1_PTE_PROT_SP_DIS;
+		if (!dart_is_s5l(data) || !(s5l_fmt & 2))
+			pte |= APPLE_DART1_PTE_PROT_SP_DIS;
 		if (!(prot & IOMMU_WRITE))
 			pte |= APPLE_DART1_PTE_PROT_NO_WRITE;
 		if (!(prot & IOMMU_READ))
diff --git a/include/linux/io-pgtable.h b/include/linux/io-pgtable.h
index e19872e37..5df36802f 100644
--- a/include/linux/io-pgtable.h
+++ b/include/linux/io-pgtable.h
@@ -103,6 +103,7 @@ struct io_pgtable_cfg {
 	#define IO_PGTABLE_QUIRK_ARM_HD			BIT(7)
 	#define IO_PGTABLE_QUIRK_ARM_S2FWB		BIT(8)
 	#define IO_PGTABLE_QUIRK_NO_WARN		BIT(9)
+	#define IO_PGTABLE_QUIRK_APPLE_DART_S5L		BIT(10)
 	unsigned long			quirks;
 	unsigned long			pgsize_bitmap;
 	unsigned int			ias;
