From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:24:05 +0000
Subject: [PATCH 052/138] arm64: dts: apple: t7000-n61: Add the NFC controller

The NXP PN548-class controller sits on UART3, VEN on GPIO 177 and the
download request line on GPIO 192 (ADT /arm-io/uart3/stockholm).

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000-n61.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n61.dts b/arch/arm64/boot/dts/apple/t7000-n61.dts
index d7eea3892..0f43267be 100644
--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -191,6 +191,13 @@ touchscreen@0 {
 /* ADT /arm-io/uart3/stockholm: NXP PN548-class NFC controller */
 &serial3 {
 	status = "okay";
+
+	nfc {
+		compatible = "nxp,pn548-uart";
+		/* ADT function-enable / function-download_request */
+		enable-gpios = <&pinctrl 177 GPIO_ACTIVE_HIGH>;
+		firmware-gpios = <&pinctrl 192 GPIO_ACTIVE_HIGH>;
+	};
 };
 
 &serial1 {
