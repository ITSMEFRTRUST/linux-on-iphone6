From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:56:12 +0000
Subject: [PATCH 013/138] arm64: dts: apple: t7000: Add NCO and MCA2

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000.dtsi | 29 ++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000.dtsi b/arch/arm64/boot/dts/apple/t7000.dtsi
index ec21ec07f..c93e65851 100644
--- a/arch/arm64/boot/dts/apple/t7000.dtsi
+++ b/arch/arm64/boot/dts/apple/t7000.dtsi
@@ -26,6 +26,14 @@ clkref: clock-ref {
 		clock-output-names = "clkref";
 	};
 
+	/* 2.4 GHz / 7, per the iOS device tree and AppleS5L8960XNCO */
+	nco_clkref: clock-ref-nco {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <342857142>;
+		clock-output-names = "nco_ref";
+	};
+
 	cpus {
 		#address-cells = <2>;
 		#size-cells = <0>;
@@ -168,6 +176,20 @@ serial6: serial@20a0d8000 {
 			status = "disabled";
 		};
 
+		mca2: i2s@20a0a8000 {
+			compatible = "apple,t7000-mca";
+			reg = <0x2 0x0a0a8000 0x0 0x4000>,
+			      <0x2 0x0a000000 0x0 0x4000>,
+			      <0x2 0x0a100000 0x0 0x1000>;
+			reg-names = "mca", "wrapper", "shim1";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 171 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&nco 2>;
+			power-domains = <&ps_mca2>;
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
 		i2c0: i2c@20a110000 {
 			compatible = "apple,t7000-i2c", "apple,i2c";
 			reg = <0x2 0x0a110000 0x0 0x1000>;
@@ -286,6 +308,13 @@ ehci2: usb-ehci@20c500000 {
 #endif
 		};
 
+		nco: clock-controller@20e011000 {
+			compatible = "apple,t7000-nco";
+			reg = <0x2 0x0e011000 0x0 0x4014>;
+			clocks = <&nco_clkref>;
+			#clock-cells = <1>;
+		};
+
 		pmgr: power-management@20e000000 {
 			compatible = "apple,t7000-pmgr", "apple,pmgr", "syscon", "simple-mfd";
 			#address-cells = <1>;
