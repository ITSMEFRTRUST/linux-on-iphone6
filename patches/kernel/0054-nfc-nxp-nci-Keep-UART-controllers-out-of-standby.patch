From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:39:22 +0000
Subject: [PATCH 054/138] nfc: nxp-nci: Keep UART controllers out of standby

In standby the controller deasserts RTS, so a UART host with flow
control can never send the byte that would wake it: the next command
hangs and every request times out. The iOS stack disables standby
with the NXP SET_POWER_MODE proprietary command (2F 00 01 00); do the
same from post_setup when the phy asks for it, and bound UART writes.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/nfc/nxp-nci/core.c    | 31 +++++++++++++++++++++++++++++++
 drivers/nfc/nxp-nci/nxp-nci.h |  6 ++++++
 drivers/nfc/nxp-nci/uart.c    |  5 +++--
 3 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/drivers/nfc/nxp-nci/core.c b/drivers/nfc/nxp-nci/core.c
index 448e5a4e7..15e53bae6 100644
--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -123,11 +123,42 @@ static const struct nci_driver_ops nxp_nci_core_ops[] = {
 	},
 };
 
+#define NXP_NCI_PROP_SET_POWER_MODE	0x00
+#define NXP_NCI_POWER_MODE_NO_STANDBY	0x00
+
+static int nxp_nci_post_setup(struct nci_dev *ndev)
+{
+	struct nxp_nci_info *info = nci_get_drvdata(ndev);
+	static const u8 mode = NXP_NCI_POWER_MODE_NO_STANDBY;
+
+	if (!info->disable_standby)
+		return 0;
+
+	return nci_prop_cmd(ndev, NXP_NCI_PROP_SET_POWER_MODE, 1, &mode);
+}
+
+static int nxp_nci_prop_rsp(struct nci_dev *ndev, struct sk_buff *skb)
+{
+	nci_req_complete(ndev, skb->len ? skb->data[0] : NCI_STATUS_SYNTAX_ERROR);
+	return 0;
+}
+
+static const struct nci_driver_ops nxp_nci_prop_ops[] = {
+	{
+		.opcode = nci_opcode_pack(NCI_GID_PROPRIETARY,
+					  NXP_NCI_PROP_SET_POWER_MODE),
+		.rsp = nxp_nci_prop_rsp,
+	},
+};
+
 static const struct nci_ops nxp_nci_ops = {
 	.open = nxp_nci_open,
 	.close = nxp_nci_close,
 	.send = nxp_nci_send,
+	.post_setup = nxp_nci_post_setup,
 	.fw_download = nxp_nci_fw_download,
+	.prop_ops = nxp_nci_prop_ops,
+	.n_prop_ops = ARRAY_SIZE(nxp_nci_prop_ops),
 	.core_ops = nxp_nci_core_ops,
 	.n_core_ops = ARRAY_SIZE(nxp_nci_core_ops),
 };
diff --git a/drivers/nfc/nxp-nci/nxp-nci.h b/drivers/nfc/nxp-nci/nxp-nci.h
index ae3fb2735..82fc34065 100644
--- a/drivers/nfc/nxp-nci/nxp-nci.h
+++ b/drivers/nfc/nxp-nci/nxp-nci.h
@@ -58,6 +58,12 @@ struct nxp_nci_info {
 
 	const struct nxp_nci_phy_ops *phy_ops;
 	unsigned int max_payload;
+	/*
+	 * Keep the controller out of standby. Needed when a standby
+	 * controller can't be woken by the transport (UART with flow
+	 * control: it deasserts RTS while asleep).
+	 */
+	bool disable_standby;
 
 	struct mutex info_lock;
 
diff --git a/drivers/nfc/nxp-nci/uart.c b/drivers/nfc/nxp-nci/uart.c
index 6bd81e035..56af409da 100644
--- a/drivers/nfc/nxp-nci/uart.c
+++ b/drivers/nfc/nxp-nci/uart.c
@@ -72,8 +72,8 @@ static int nxp_nci_uart_write(void *phy_id, struct sk_buff *skb)
 	if (debug)
 		print_hex_dump(KERN_INFO, "nfc tx: ", DUMP_PREFIX_NONE, 32, 1,
 			       skb->data, skb->len, false);
-	r = serdev_device_write(phy->serdev, skb->data, skb->len,
-				MAX_SCHEDULE_TIMEOUT);
+	/* Bounded: a controller that holds RTS deasserted must not hang us */
+	r = serdev_device_write(phy->serdev, skb->data, skb->len, HZ);
 	if (r < 0)
 		return r;
 
@@ -203,6 +203,7 @@ static int nxp_nci_uart_probe(struct serdev_device *serdev)
 	if (r < 0)
 		goto err_close;
 
+	((struct nxp_nci_info *)nci_get_drvdata(phy->ndev))->disable_standby = true;
 	return 0;
 
 err_close:
