From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Sun, 18 Oct 2026 03:19:03 +0000
Subject: [PATCH 032/138] dt-bindings: gpio: Add the Apple PMIC GPIO controller

The Dialog based PMICs of Apple A8 devices have general purpose pins,
one config register each. On the iPhone 6 they switch the power of the
Wi-Fi/Bluetooth chip. Describe them as a child of the PMIC.

Assisted-by: Claude:claude-opus-5-5
---
 .../bindings/gpio/apple,adi-pmic-gpio.yaml    | 59 +++++++++++++++++++
 .../devicetree/bindings/mfd/apple,pmic.yaml   |  3 +
 2 files changed, 62 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/gpio/apple,adi-pmic-gpio.yaml

diff --git a/Documentation/devicetree/bindings/gpio/apple,adi-pmic-gpio.yaml b/Documentation/devicetree/bindings/gpio/apple,adi-pmic-gpio.yaml
new file mode 100644
index 000000000..c18587727
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/apple,adi-pmic-gpio.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/apple,adi-pmic-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple PMIC GPIO controller
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description:
+  The general purpose pins of an Apple PMIC (see ../mfd/apple,pmic.yaml).
+  Each pin has its own config register; on the iPhone 6 they switch the
+  power of the Wi-Fi/Bluetooth chip.
+
+properties:
+  compatible:
+    enum:
+      - apple,adi-pmic-gpio
+
+  reg:
+    maxItems: 1
+    description:
+      Address and size of the block of per-pin config registers.
+
+  gpio-controller: true
+
+  "#gpio-cells":
+    const: 2
+
+required:
+  - compatible
+  - reg
+  - gpio-controller
+  - "#gpio-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@74 {
+            compatible = "apple,adi-pmic", "apple,i2c-pmic";
+            reg = <0x74>;
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            gpio@400 {
+                compatible = "apple,adi-pmic-gpio";
+                reg = <0x400 0x2a>;
+                gpio-controller;
+                #gpio-cells = <2>;
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 578ee1f04..512eb7765 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -67,6 +67,9 @@ patternProperties:
   "^ldo[0-9]+(@[0-9a-f]+)?$":
     $ref: /schemas/regulator/apple,adi-pmic-ldo.yaml
 
+  "^gpio(@[0-9a-f]+)?$":
+    $ref: /schemas/gpio/apple,adi-pmic-gpio.yaml
+
 required:
   - compatible
   - reg
