 		isp_stream_stop(isp);
@@ -69,6 +71,7 @@ static long isp_ioctl(struct file *f, unsigned int cmd, unsigned long arg)
 	u32 v;
 	long ret;
 
+	isp_trace_mark(isp, "ioctl 0x%x", cmd);
 	switch (cmd) {
 	case ISP_IOC_INFO:
 		memset(&info, 0, sizeof(info));
