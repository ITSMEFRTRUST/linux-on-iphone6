+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/apple,t7000-touch-clk.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple A8 PMGR touch clock
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description:
+  The PMGR of the Apple A8 (t7000) has a TOUCH_CTL register that gates and
+  divides the reference clock, which is used as the 32.768 kHz clock of the
+  multi-touch controller. This node describes that register as a clock and
+  is a child of the PMGR syscon node.
+
+properties:
+  compatible:
+    const: apple,t7000-touch-clk
+
+  reg:
+    maxItems: 1
+    description:
+      Offset of the TOUCH_CTL register in the parent PMGR syscon.
+
+  clocks:
+    maxItems: 1
+    description: 24 MHz reference clock.
+
+  '#clock-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        power-management@20e000000 {
+            compatible = "apple,t7000-pmgr", "apple,pmgr", "syscon", "simple-mfd";
+            #address-cells = <1>;
+            #size-cells = <1>;
+            reg = <0x2 0x0e000000 0x0 0x24000>;
+
+            clock-controller@1e000 {
+                compatible = "apple,t7000-touch-clk";
+                reg = <0x1e000 0x4>;
+                clocks = <&clkref>;
+                #clock-cells = <0>;
+            };
+        };
+    };
