+/*
+ * T7000 (A8) support.
+ *
+ * Everything below follows the order of AppleT7000PCIe/AppleEmbeddedPCIE
+ * in iOS 12. Every step is logged, and the "t7000_stage" module parameter
+ * stops the bring-up (and fails the probe) after a given stage, so that a
+ * new board can be brought up one register block at a time:
+ *
+ *   0: don't touch the controller at all
+ *   1: power domains on, common registers dumped (read only)
+ *   2: + PHY init
+ *   3: + port enable through the common block (no port/ECAM access yet)
+ *   4: + port registers read (link status, LTSSM state)
+ *   5: + root port config space (IDs, target link speed) and tunables
+ *   6: everything: IRQs, MSIs, PERST#, link training, enumeration
+ *
+ * While this is unproven on hardware, a built-in driver defaults to 0 and
+ * a module to 6, so the bring-up only ever runs on an explicit insmod.
+ */
+static unsigned int t7000_stage = IS_MODULE(CONFIG_PCIE_APPLE) ? 6 : 0;
+module_param(t7000_stage, uint, 0444);
+MODULE_PARM_DESC(t7000_stage,
+		 "T7000: last bring-up stage to run (0 = none ... 6 = all)");
+
+static int apple_pcie_t7000_stop(struct apple_pcie *pcie, unsigned int stage)
+{
+	if (t7000_stage > stage)
+		return 0;
+
+	dev_info(pcie->dev, "T7000: stopping after stage %u as requested\n",
+		 stage);
+	return -ENODEV;
+}
+
+static void apple_pcie_t7000_rc_dump(struct apple_pcie *pcie, int p,
+				     const char *when)
+{
+	void __iomem *rc = pcie->base;
+
+	dev_info(pcie->dev,
+		 "T7000: rc port%d %s: ctl %08x refclk %08x pwrdn %08x rst %08x phyctl %08x\n",
+		 p, when,
+		 readl_relaxed(rc + T7000_RC_PORT_CTL(p)),
+		 readl_relaxed(rc + T7000_RC_PORT_REFCLK(p)),
+		 readl_relaxed(rc + T7000_RC_PORT_PWRDN(p)),
+		 readl_relaxed(rc + T7000_RC_PORT_RST(p)),
+		 readl_relaxed(rc + T7000_RC_PHY_CTL(p / 2)));
+}
+
+static void apple_pcie_t7000_port_report(struct apple_pcie_port *port,
+					 const char *when)
+{
+	u32 sts = readl_relaxed(port->base + T7000_PORT_LINKSTS);
+	u32 ltssm = readl_relaxed(port->base + T7000_PORT_LTSSM);
+
+	dev_info(port->pcie->dev,
+		 "T7000: port%d %s: linksts %08x (up %d, L2 %d) ltssm %08x (state %#lx) intstat %08x intmsk %08x msicfg %08x\n",
+		 port->idx, when, sts, !!(sts & T7000_PORT_LINKSTS_UP),
+		 !!(sts & T7000_PORT_LINKSTS_L2), ltssm,
+		 FIELD_GET(T7000_PORT_LTSSM_STATE, ltssm),
+		 readl_relaxed(port->base + PORT_INTSTAT),
+		 readl_relaxed(port->base + PORT_INTMSK),
+		 readl_relaxed(port->base + PORT_MSICFG));
+}
+
+static void apple_pcie_t7000_phy_write(struct apple_pcie *pcie, u32 reg,
+				       u32 val)
+{
+	writel(val, pcie->phy + reg);
+	dev_info(pcie->dev, "T7000: phy0[%#x] = %#x, reads back %#x\n", reg,
+		 val, readl(pcie->phy + reg));
+}
+
+static int apple_pcie_t7000_init_rc(struct apple_pcie *pcie)
+{
+	struct platform_device *pdev = to_platform_device(pcie->dev);
+	void __iomem *rc = pcie->base;
+	int ret;
+
+	pcie->phy = devm_platform_ioremap_resource_byname(pdev, "phy0");
+	if (IS_ERR(pcie->phy))
+		return PTR_ERR(pcie->phy);
+
+	/* iOS: IODelay(10) after the PCIE, PCIE_AUX and PCIE_REF gates */
+	usleep_range(10, 20);
+
+	apple_pcie_t7000_rc_dump(pcie, 0, "at probe");
+	apple_pcie_t7000_rc_dump(pcie, 1, "at probe");
+
+	ret = apple_pcie_t7000_stop(pcie, 1);
+	if (ret)
+		return ret;
+
+	/*
+	 * PHY 0 (ports 0 and 1) settings from the ADT "phy0-settings". iOS
+	 * opens the PHY config path through port 0's fields even when only
+	 * port 1 is used. The refclk is internal on N61, so no 0xc3c write.
+	 */
+	dev_info(pcie->dev, "T7000: PHY 0 init\n");
+	rmw_set(T7000_RC_PHY_CTL_CFG_EN, rc + T7000_RC_PHY_CTL(0));
+	rmw_set(T7000_RC_PORT_CTL_EN, rc + T7000_RC_PORT_CTL(0));
+	rmw_set(T7000_RC_PORT_RST_DEASSERT, rc + T7000_RC_PORT_RST(0));
+
+	apple_pcie_t7000_phy_write(pcie, T7000_PHY_CFG0, T7000_PHY_CFG_VAL);
+	apple_pcie_t7000_phy_write(pcie, T7000_PHY_CFG1, T7000_PHY_CFG_VAL);
+
+	rmw_clear(T7000_RC_PORT_RST_DEASSERT, rc + T7000_RC_PORT_RST(0));
+	rmw_clear(T7000_RC_PORT_CTL_EN, rc + T7000_RC_PORT_CTL(0));
+	rmw_clear(T7000_RC_PHY_CTL_CFG_EN, rc + T7000_RC_PHY_CTL(0));
+
+	apple_pcie_t7000_rc_dump(pcie, 0, "after PHY init");
+
+	return apple_pcie_t7000_stop(pcie, 2);
+}
+
+/* Root port config space, which is also the DesignWare DBI */
+static void __iomem *apple_pcie_t7000_rc_cfg(struct apple_pcie_port *port)
+{
+	/* 64-bit only: the whole ECAM window is mapped at once */
+	return port->pcie->cfg->win + (PCI_DEVFN(port->idx, 0) << 12);
+}
+
+static int apple_pcie_t7000_find_pcie_cap(void __iomem *cfg)
+{
+	int pos, ttl = 48;
+
+	if (!(readw(cfg + PCI_STATUS) & PCI_STATUS_CAP_LIST))
+		return 0;
+
+	pos = readb(cfg + PCI_CAPABILITY_LIST) & ~3;
+	while (pos >= PCI_STD_HEADER_SIZEOF && ttl--) {
+		if (readb(cfg + pos + PCI_CAP_LIST_ID) == PCI_CAP_ID_EXP)
+			return pos;
+		pos = readb(cfg + pos + PCI_CAP_LIST_NEXT) & ~3;
+	}
+
+	return 0;
+}
+
+static int apple_pcie_t7000_port_enable(struct apple_pcie_port *port)
+{
+	struct apple_pcie *pcie = port->pcie;
+	struct device *dev = pcie->dev;
+	void __iomem *rc = pcie->base;
+	void __iomem *cfg;
+	int p = port->idx, cap, speed, ret;
+	u32 id, val;
+
+	/* AppleEmbeddedPCIEPort::enablePortHardware */
+	apple_pcie_t7000_rc_dump(pcie, p, "before enable");
+
+	rmw_clear(T7000_RC_PORT_RST_DEASSERT, rc + T7000_RC_PORT_RST(p));
+	rmw_set(T7000_RC_PORT_REFCLK_EN, rc + T7000_RC_PORT_REFCLK(p));
+	usleep_range(100, 200);
+	rmw_clear(T7000_RC_PORT_PWRDN_EN, rc + T7000_RC_PORT_PWRDN(p));
+	rmw_set(T7000_RC_PORT_CTL_EN, rc + T7000_RC_PORT_CTL(p));
+	msleep(T7000_REFCLK_TO_RESET_MS);
+	rmw_set(T7000_RC_PORT_RST_DEASSERT, rc + T7000_RC_PORT_RST(p));
+	/*
+	 * iOS then clears REFCLK_CGDIS to allow refclk gating; keep the
+	 * clock ungated until the link is known to work.
+	 */
+	apple_pcie_t7000_rc_dump(pcie, p, "after enable");
+
+	ret = apple_pcie_t7000_stop(pcie, 3);
+	if (ret)
+		return ret;
+
+	apple_pcie_t7000_port_report(port, "after enable");
+
+	ret = apple_pcie_t7000_stop(pcie, 4);
+	if (ret)
+		return ret;
+
+	cfg = apple_pcie_t7000_rc_cfg(port);
+	id = readl(cfg + PCI_VENDOR_ID);
+	dev_info(dev, "T7000: root port %02x.0: id %08x class %08x dwc version %08x type %08x\n",
+		 p, id, readl(cfg + PCI_CLASS_REVISION), readl(cfg + 0x8f8),
+		 readl(cfg + 0x8fc));
+	if (PCI_POSSIBLE_ERROR(id) || !id) {
+		dev_err(dev, "T7000: root port config space is dead\n");
+		return -ENODEV;
+	}
+
+	/* Target link speed, from the ADT "maximum-link-speed" */
+	cap = apple_pcie_t7000_find_pcie_cap(cfg);
+	speed = of_pci_get_max_link_speed(port->np);
+	if (cap && speed > 0) {
+		val = readl(cfg + cap + PCI_EXP_LNKCTL2);
+		/* Same mask as iOS: this leaves LNKSTA2 (RW1C) alone */
+		writel((val & 0xfff0) | speed, cfg + cap + PCI_EXP_LNKCTL2);
+		dev_info(dev, "T7000: root port %02x.0: PCIe cap %#x lnkcap %08x lnkcap2 %08x lnkctl2 %08x -> %08x\n",
+			 p, cap, readl(cfg + cap + PCI_EXP_LNKCAP),
+			 readl(cfg + cap + PCI_EXP_LNKCAP2), val,
+			 readl(cfg + cap + PCI_EXP_LNKCTL2));
+	} else {
+		dev_warn(dev, "T7000: root port %02x.0: PCIe cap %#x, speed %d, link speed left alone\n",
+			 p, cap, speed);
+	}
+
+	/* ADT "apcie-config-tunables" */
+	val = readl_relaxed(port->base + T7000_PORT_TUN90);
+	val &= ~T7000_PORT_TUN90_MASK;
+	writel_relaxed(val | T7000_PORT_TUN90_VAL,
+		       port->base + T7000_PORT_TUN90);
+	rmw_set(T7000_PORT_TUN130_VAL, port->base + T7000_PORT_TUN130);
+	rmw_set(T7000_PORT_TUN134_VAL, port->base + T7000_PORT_TUN134);
+	dev_info(dev, "T7000: port%d tunables: [0x90] %08x [0x130] %08x [0x134] %08x\n",
+		 p, readl_relaxed(port->base + T7000_PORT_TUN90),
+		 readl_relaxed(port->base + T7000_PORT_TUN130),
+		 readl_relaxed(port->base + T7000_PORT_TUN134));
+
+	/* AppleEmbeddedPCIEPort::enableInterrupts, purpose unknown */
+	writel_relaxed(0, port->base + T7000_PORT_IRQCFG);
+
+	return apple_pcie_t7000_stop(pcie, 5);
+}
+
+/*
+ * iOS panics on config accesses to unpowered ports, and port 0 (the
+ * unused NVMe port on phones) is never powered up here. Only expose
+ * the root ports we brought up, and their buses only when a link is up.
+ */
+static void __iomem *apple_pcie_t7000_map_bus(struct pci_bus *bus,
+					      unsigned int devfn, int where)
+{
+	struct pci_config_window *cfg = bus->sysdata;
+	struct apple_pcie *pcie = apple_pcie_lookup(cfg->parent);
+	struct apple_pcie_port *port;
+
+	list_for_each_entry(port, &pcie->ports, entry) {
+		if (pci_is_root_bus(bus)) {
+			if (devfn == PCI_DEVFN(port->idx, 0))
+				return pci_ecam_map_bus(bus, devfn, where);
+		} else if (readl_relaxed(port->base + T7000_PORT_LINKSTS) &
+			   T7000_PORT_LINKSTS_UP) {
+			return pci_ecam_map_bus(bus, devfn, where);
+		}
+	}
+
+	return NULL;
+}
+
+static const struct pci_ecam_ops apple_pcie_t7000_cfg_ecam_ops = {
+	.init		= apple_pcie_init,
+	.pci_ops	= {
+		.map_bus	= apple_pcie_t7000_map_bus,
+		.read		= pci_generic_config_read,
+		.write		= pci_generic_config_write,
+	}
+};
+
+static const struct hw_info t7000_hw = {
+	.port_msiaddr		= 0,
+	.port_linkcmdsts	= T7000_PORT_LINKCMDSTS,
+	.max_rid2sid		= 0,
+	.fixed_msi_doorbell	= T7000_MSI_DOORBELL,
+	/* iOS uses 100ms; be generous on a first bring-up */
+	.link_timeout_ms	= 500,
+	.init_rc		= apple_pcie_t7000_init_rc,
+	.port_enable		= apple_pcie_t7000_port_enable,
+	.ecam_ops		= &apple_pcie_t7000_cfg_ecam_ops,
+};
+
 static int apple_pcie_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -863,6 +1284,20 @@ static int apple_pcie_probe(struct platform_device *pdev)
