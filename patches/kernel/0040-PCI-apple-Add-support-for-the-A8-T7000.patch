+#define T7000_RC_PHY_CTL(phy)		(0x040 + 0x20 * (phy))
+#define   T7000_RC_PHY_CTL_CFG_EN	BIT(0)
+#define T7000_RC_PORT_CTL(p)		(0x100 + 0x80 * (p))
+#define   T7000_RC_PORT_CTL_EN		BIT(0)
+#define T7000_RC_PORT_REFCLK(p)		(0x108 + 0x80 * (p))
+#define   T7000_RC_PORT_REFCLK_EN	BIT(0)
+#define   T7000_RC_PORT_REFCLK_CGDIS	BIT(8)
+#define T7000_RC_PORT_PWRDN(p)		(0x10c + 0x80 * (p))
+#define   T7000_RC_PORT_PWRDN_EN	BIT(0)
+#define T7000_RC_PORT_RST(p)		(0x118 + 0x80 * (p))
+#define   T7000_RC_PORT_RST_DEASSERT	BIT(0)
+
+/* PHY block, shared by ports 2n and 2n + 1 */
+#define T7000_PHY_CFG0			0xc24
+#define T7000_PHY_CFG1			0xc28
+#define   T7000_PHY_CFG_VAL		0x3f
+
+/* Port block (same base as the M1 port block, a few different offsets) */
+#define T7000_PORT_LINKSTS		0x088
+#define   T7000_PORT_LINKSTS_UP		BIT(0)
+#define   T7000_PORT_LINKSTS_L2		BIT(6)
+#define T7000_PORT_TUN90		0x090
+#define   T7000_PORT_TUN90_MASK		GENMASK(7, 0)
+#define   T7000_PORT_TUN90_VAL		0x28
+#define T7000_PORT_IRQCFG		0x114
+#define T7000_PORT_TUN130		0x130
+#define   T7000_PORT_TUN130_VAL		0x3
+#define T7000_PORT_TUN134		0x134
+#define   T7000_PORT_TUN134_VAL		0x1
+#define T7000_PORT_LTSSM		0x804
+#define   T7000_PORT_LTSSM_STATE	GENMASK(14, 9)
+#define T7000_PORT_LINKCMDSTS		0x808
+
+/* Not programmable, hardwired in the controller */
