 	if (!pcie->hw)
 		return -ENODEV;
+
+	if (pcie->hw == &t7000_hw && !t7000_stage) {
+		dev_info(dev, "T7000: bring-up disabled (t7000_stage=0)\n");
+		return -ENODEV;
