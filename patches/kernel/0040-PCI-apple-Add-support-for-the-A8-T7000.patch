+	if (pcie->hw->fixed_msi_doorbell &&
+	    pcie->hw->fixed_msi_doorbell != DOORBELL_ADDR) {
+		dev_err(dev, "MSI doorbell is hardwired at %#x, build with CONFIG_PCIE_APPLE_MSI_DOORBELL_ADDR=%#x\n",
+			pcie->hw->fixed_msi_doorbell,
+			pcie->hw->fixed_msi_doorbell);
+		return -EINVAL;
+	}
+
 	pcie->base = devm_platform_ioremap_resource(pdev, 1);
 	if (IS_ERR(pcie->base))
 		return PTR_ERR(pcie->base);
@@ -874,11 +1309,18 @@ static int apple_pcie_probe(struct platform_device *pdev)
 	if (ret)
