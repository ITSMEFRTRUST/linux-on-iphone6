 1 file changed, 81 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/cirrus,cs42l67.yaml

diff --git a/Documentation/devicetree/bindings/sound/cirrus,cs42l67.yaml b/Documentation/devicetree/bindings/sound/cirrus,cs42l67.yaml
new file mode 100644
index 000000000..94226733c
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/cirrus,cs42l67.yaml
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/cirrus,cs42l67.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Cirrus Logic CS42L67 audio codec
+
+maintainers:
+  - ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
+
+description: |
+  Headset, microphone and receiver codec on SPI, found in the Apple iPhone 6.
+  It has analog microphone inputs AIN1-AIN7 with MICBIAS outputs, a headset
+  microphone input, and serial ports ASP, XSP and VSP. Only the XSP port
+  (TDM, the codec is clock consumer) is described here.
+
+allOf:
+  - $ref: dai-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: cirrus,cs42l67
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency:
+    maximum: 12000000
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: 12 MHz MCLK
+
+  clock-names:
+    const: mclk
+
+  cirrus,xsp-tx-slot:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 15
+    default: 4
+    description: TDM slot of XSP TX (capture) channel 1; further channels follow.
+
+  cirrus,xsp-rx-slot:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 15
+    default: 0
+    description: TDM slot that XSP RX (playback) channel 1 takes its data from.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        codec@0 {
+            compatible = "cirrus,cs42l67";
+            reg = <0>;
+            spi-max-frequency = <1000000>;
+            interrupts-extended = <&pinctrl 127 IRQ_TYPE_LEVEL_LOW>;
+            clocks = <&mca2 0>;
+            clock-names = "mclk";
+            #sound-dai-cells = <0>;
+        };
+    };
