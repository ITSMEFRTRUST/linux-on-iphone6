From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Thu, 22 Oct 2026 02:35:15 +0000
Subject: [PATCH 104/138] rtc: apple-pmic: Add the alarm of the D2186

iOS sets the alarm at base + 0x0 (32 bit, whole seconds of the counter)
and switches it with base + 0x4 = 0x41 (on) or 0x01 (off). Its event comes
from the PMU's event controller. Register the alarm, as a wake source,
only when an interrupt is described, and keep it one-shot.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/rtc/rtc-apple-pmic.c | 139 ++++++++++++++++++++++++++++++++++-
 1 file changed, 138 insertions(+), 1 deletion(-)

diff --git a/drivers/rtc/rtc-apple-pmic.c b/drivers/rtc/rtc-apple-pmic.c
index ee56618c8..1e3d7fc09 100644
--- a/drivers/rtc/rtc-apple-pmic.c
+++ b/drivers/rtc/rtc-apple-pmic.c
@@ -8,6 +8,8 @@
  * Copyright (c) 2023, Linaro Limited
  * Copyright (c) 2025, Nick Chan
  */
+#include <linux/bits.h>
+#include <linux/interrupt.h>
 #include <linux/of.h>
 #include <linux/module.h>
 #include <linux/nvmem-consumer.h>
@@ -24,22 +26,37 @@
 #include <asm/byteorder.h>
 
 #define RTC_COUNTER_SIZE 6
+#define RTC_ALARM_SIZE 4
+
+/*
+ * Alarm control as the iOS D2186 driver writes it: 0x41 = alarm on,
+ * 0x01 = off. Bit 0 is always set by iOS, its meaning is unknown.
+ */
+#define RTC_ALARM_CTRL_ON	BIT(0)
+#define RTC_ALARM_CTRL_EN	BIT(6)
 
 /**
  * struct apple_pmic_rtc_regs -	RTC Hardware registers
  * @control:			RTC Control
  * @counter:			Time Counter
+ * @alarm:			Alarm, in whole seconds of the counter
+ * @alarm_ctrl:			Alarm control
+ * @has_alarm:			@alarm and @alarm_ctrl are known
  */
 
 struct apple_pmic_rtc_regs {
 	u32 control;
 	u32 counter;
+	u32 alarm;
+	u32 alarm_ctrl;
+	bool has_alarm;
 };
 
 /**
  * struct apple_pmic_rtc -  RTC driver internal structure
  * @rtc:		RTC device
  * @regmap:		regmap used to access registers
+ * @dev:		platform device
  * @nvmem_cell:		nvmem cell for offset
  * @regs:		hardware registers
  * @base:		RTC base address
@@ -183,13 +200,102 @@ static int apple_pmic_rtc_read_time(struct device *dev, struct rtc_time *tm)
 	return 0;
 }
 
+static int apple_pmic_rtc_alarm_irq_enable(struct device *dev,
+					   unsigned int enable)
+{
+	struct apple_pmic_rtc *ap_rtc = dev_get_drvdata(dev);
+
+	return regmap_update_bits(ap_rtc->regmap,
+				  ap_rtc->base + ap_rtc->regs->alarm_ctrl,
+				  RTC_ALARM_CTRL_EN | RTC_ALARM_CTRL_ON,
+				  RTC_ALARM_CTRL_ON |
+				  (enable ? RTC_ALARM_CTRL_EN : 0));
+}
+
+static int apple_pmic_rtc_read_alarm(struct device *dev,
+				     struct rtc_wkalrm *alarm)
+{
+	struct apple_pmic_rtc *ap_rtc = dev_get_drvdata(dev);
+	unsigned int ctrl;
+	u8 value[RTC_ALARM_SIZE];
+	int rc;
+
+	rc = regmap_bulk_read(ap_rtc->regmap,
+			      ap_rtc->base + ap_rtc->regs->alarm, value,
+			      sizeof(value));
+	if (rc)
+		return rc;
+
+	rc = regmap_read(ap_rtc->regmap,
+			 ap_rtc->base + ap_rtc->regs->alarm_ctrl, &ctrl);
+	if (rc)
+		return rc;
+
+	rtc_time64_to_tm((s64)get_unaligned_le32(value) + ap_rtc->offset,
+			 &alarm->time);
+	alarm->enabled = !!(ctrl & RTC_ALARM_CTRL_EN);
+
+	return 0;
+}
+
+static int apple_pmic_rtc_set_alarm(struct device *dev,
+				    struct rtc_wkalrm *alarm)
+{
+	struct apple_pmic_rtc *ap_rtc = dev_get_drvdata(dev);
+	s64 raw = rtc_tm_to_time64(&alarm->time) - ap_rtc->offset;
+	u8 value[RTC_ALARM_SIZE];
+	int rc;
+
+	if (raw < 0 || raw > U32_MAX)
+		return -ERANGE;
+
+	rc = apple_pmic_rtc_alarm_irq_enable(dev, 0);
+	if (rc)
+		return rc;
+
+	put_unaligned_le32(raw, value);
+	rc = regmap_bulk_write(ap_rtc->regmap,
+			       ap_rtc->base + ap_rtc->regs->alarm, value,
+			       sizeof(value));
+	if (rc)
+		return rc;
+
+	if (alarm->enabled)
+		rc = apple_pmic_rtc_alarm_irq_enable(dev, 1);
+
+	return rc;
+}
+
+static irqreturn_t apple_pmic_rtc_alarm_irq(int irq, void *data)
+{
+	struct apple_pmic_rtc *ap_rtc = data;
+
+	/* One-shot: the alarm stays armed in the PMU otherwise */
+	apple_pmic_rtc_alarm_irq_enable(ap_rtc->dev, 0);
+	rtc_update_irq(ap_rtc->rtc, 1, RTC_IRQF | RTC_AF);
+
+	return IRQ_HANDLED;
+}
+
 static const struct rtc_class_ops apple_pmic_rtc_ops = {
 	.read_time	= apple_pmic_rtc_read_time,
 	.set_time	= apple_pmic_rtc_set_time,
 };
 
+static const struct rtc_class_ops apple_pmic_rtc_alarm_ops = {
+	.read_time		= apple_pmic_rtc_read_time,
+	.set_time		= apple_pmic_rtc_set_time,
+	.read_alarm		= apple_pmic_rtc_read_alarm,
+	.set_alarm		= apple_pmic_rtc_set_alarm,
+	.alarm_irq_enable	= apple_pmic_rtc_alarm_irq_enable,
+};
+
+/* Alarm layout from the iOS 12 AppleD2186PMU driver (base 0x5c0) */
 static const struct apple_pmic_rtc_regs amber_regs = {
-	.counter = 0x6
+	.counter = 0x6,
+	.alarm = 0x0,
+	.alarm_ctrl = 0x4,
+	.has_alarm = true,
 };
 
 static const struct apple_pmic_rtc_regs antigua_regs = {
@@ -230,6 +336,7 @@ static int apple_pmic_rtc_probe(struct platform_device *pdev)
 	struct device_node *node = pdev->dev.of_node;
 	const struct of_device_id *match;
 	struct apple_pmic_rtc *ap_rtc;
+	int irq = 0;
 	int rc;
 
 	match = of_match_node(apple_pmic_id_table, node);
@@ -255,6 +362,13 @@ static int apple_pmic_rtc_probe(struct platform_device *pdev)
 	if (rc)
 		return rc;
 
+	/* The alarm interrupt comes from the PMIC's event controller */
+	if (ap_rtc->regs->has_alarm) {
+		irq = platform_get_irq_optional(pdev, 0);
+		if (irq == -EPROBE_DEFER)
+			return irq;
+	}
+
 	platform_set_drvdata(pdev, ap_rtc);
 
 	ap_rtc->rtc = devm_rtc_allocate_device(&pdev->dev);
@@ -265,6 +379,29 @@ static int apple_pmic_rtc_probe(struct platform_device *pdev)
 	ap_rtc->rtc->range_min = INT_MIN;
 	ap_rtc->rtc->range_max = INT_MAX;
 
+	if (irq > 0) {
+		rc = devm_request_threaded_irq(&pdev->dev, irq, NULL,
+					       apple_pmic_rtc_alarm_irq,
+					       IRQF_ONESHOT, "rtc-alarm",
+					       ap_rtc);
+		if (rc) {
+			dev_warn(&pdev->dev, "alarm interrupt unusable: %d\n",
+				 rc);
+			irq = 0;
+		}
+	}
+
+	if (irq > 0) {
+		ap_rtc->rtc->ops = &apple_pmic_rtc_alarm_ops;
+		rc = devm_device_init_wakeup(&pdev->dev);
+		if (!rc)
+			rc = devm_pm_set_wake_irq(&pdev->dev, irq);
+		if (rc)
+			dev_warn(&pdev->dev, "alarm wake unusable: %d\n", rc);
+	} else {
+		clear_bit(RTC_FEATURE_ALARM, ap_rtc->rtc->features);
+	}
+
 	return devm_rtc_register_device(ap_rtc->rtc);
 }
 
