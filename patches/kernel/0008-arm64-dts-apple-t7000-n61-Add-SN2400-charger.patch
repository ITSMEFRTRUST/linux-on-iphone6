From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ITSMEFRTRUST <215584995+ITSMEFRTRUST@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:49:42 +0000
Subject: [PATCH 008/138] arm64: dts: apple: t7000-n61: Add SN2400 charger

The USB charger is a TI SN2400 at 0x75 on i2c1. Without a driver the
phone does not charge under Linux. Start with a 500 mA input limit,
which any USB port can supply.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/apple/t7000-n61.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t7000-n61.dts b/arch/arm64/boot/dts/apple/t7000-n61.dts
index 158968f07..b27cef4ef 100644
--- a/arch/arm64/boot/dts/apple/t7000-n61.dts
+++ b/arch/arm64/boot/dts/apple/t7000-n61.dts
@@ -33,6 +33,13 @@ haptics@5a {
 	 * The IRQ (GPIO 47) is left out until its polarity is known; VA/VP
 	 * come from the PMU and are not described yet.
 	 */
+	charger@75 {
+		compatible = "ti,sn2400";
+		reg = <0x75>;
+		input-current-limit-microamp = <500000>;
+		constant-charge-current-max-microamp = <1000000>;
+	};
+
 	speaker-amp@40 {
 		compatible = "cirrus,cs35l19";
 		reg = <0x40>;
