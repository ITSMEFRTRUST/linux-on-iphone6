 /* ---------------------------------------------------------------- panel: DCS over the DSI host */
 
 /* one DCS short write without parameter, on virtual channel 0 */
@@ -545,10 +640,48 @@ static void adpt_panel_wake_locked(struct adpt *adp)
  * known, so VFTG, the DSI link (no ULPS on n61 either) and the power domains stay on.
  * Called with panel_lock held and inside drm_dev_enter().
  */
+/*
+ * Write LAYER_CTL from the next VBI interrupt and wait for it (plus one frame). Needs DRM vblank to be
+ * usable (CRTC on); fails without touching the register when it is not, when the line is gone (storm
+ * guard / stall) or when no VBI comes within ADPT_LAYER_TIMEOUT_MS.
+ */
+static int adpt_layer_ctl_sync(struct adpt *adp, u32 val)
+{
+	unsigned long flags;
+	bool armed;
+	int ret;
+
+	if (READ_ONCE(adp->irq_dead))
+		return -EIO;
+	ret = drm_crtc_vblank_get(&adp->crtc);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&adp->irq_lock, flags);
+	adp->layer_req = val;
+	adp->layer_armed = true;
+	spin_unlock_irqrestore(&adp->irq_lock, flags);
+
+	wait_event_timeout(adp->layer_wq, !READ_ONCE(adp->layer_armed),
+			   msecs_to_jiffies(ADPT_LAYER_TIMEOUT_MS));
+
+	spin_lock_irqsave(&adp->irq_lock, flags);
+	armed = adp->layer_armed;	/* still armed = never written */
+	adp->layer_armed = false;
+	spin_unlock_irqrestore(&adp->irq_lock, flags);
+	drm_crtc_vblank_put(&adp->crtc);
+	if (armed || READ_ONCE(adp->stalled))
+		return -ETIMEDOUT;
+	if (fifo_sync)
+		adpt_fifo_kick(adp);
+	msleep(ADPT_LATCH_MS);
+	return 0;
+}
