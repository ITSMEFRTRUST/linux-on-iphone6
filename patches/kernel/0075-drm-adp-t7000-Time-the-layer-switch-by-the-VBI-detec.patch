@@ -456,6 +479,22 @@ static irqreturn_t adpt_irq(int irq, void *arg)
 	if (!test_noack)
 		writel(st, adp->adp + ADP_IRQ_STATUS);	/* W1C, as iOS does */
 
+	if (st & ADP_IRQ_VBI) {
